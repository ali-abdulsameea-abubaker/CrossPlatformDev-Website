@page "/portfolio/internal-tools"
@page "/internal-tools"

<div class="page-enter">

    <!-- ===== HERO SECTION ===== -->
    <section class="tools-hero section">
        <div class="container">
            <div class="tools-hero-grid">
                <div class="tools-hero-content">
                    <div class="tools-badge reveal" style="--stagger-index:0">
                        <span class="badge-dot"></span>
                        <span>Internal Business Tools</span>
                    </div>
                    <h1 class="tools-headline reveal" style="--stagger-index:1">
                        <span class="tools-line">Systems that</span>
                        <span class="tools-line tools-line-gradient">run real businesses.</span>
                    </h1>
                    <p class="tools-description reveal" style="--stagger-index:2">
                        Custom business management systems built for security companies and supermarkets using .NET Framework and C#.
                        From employee onboarding to POS with QR scanning — I build software that powers daily operations.
                    </p>
                    <div class="tools-stats reveal" style="--stagger-index:3">
                        <div class="tools-stat">
                            <span class="tools-stat-number">4+</span>
                            <span class="tools-stat-label">Systems Built</span>
                        </div>
                        <div class="tools-stat-divider"></div>
                        <div class="tools-stat">
                            <span class="tools-stat-number">300+</span>
                            <span class="tools-stat-label">Users Supported</span>
                        </div>
                        <div class="tools-stat-divider"></div>
                        <div class="tools-stat">
                            <span class="tools-stat-number">2024</span>
                            <span class="tools-stat-label">In Production</span>
                        </div>
                    </div>
                </div>
                <div class="tools-hero-visual reveal" style="--stagger-index:2">
                    <div class="tools-orb"></div>
                    <div class="tools-icon-grid">
                        <div class="tools-icon-card floaty" style="animation-delay: 0s;">
                            <span class="tools-icon">👔</span>
                            <span class="tools-icon-label">HR</span>
                        </div>
                        <div class="tools-icon-card floaty" style="animation-delay: 0.8s;">
                            <span class="tools-icon">📋</span>
                            <span class="tools-icon-label">Ops</span>
                        </div>
                        <div class="tools-icon-card floaty" style="animation-delay: 1.6s;">
                            <span class="tools-icon">🛒</span>
                            <span class="tools-icon-label">POS</span>
                        </div>
                        <div class="tools-icon-card floaty" style="animation-delay: 0.4s;">
                            <span class="tools-icon">🔗</span>
                            <span class="tools-icon-label">Data</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== SYSTEMS DETAIL ===== -->
    <section class="tools-systems section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">the-systems</span>
                <h2>Every system I've built<br><span class="grad-text">for real operations.</span></h2>
            </div>

            <div class="systems-grid">
                <!-- System 1: HR & Administration -->
                <div class="system-card reveal" style="--stagger-index:0">
                    <div class="system-card-header">
                        <div class="system-card-icon">👔</div>
                        <div class="system-card-info">
                            <h3>HR & Administration System</h3>
                            <span class="system-card-category">.NET Framework · C#</span>
                        </div>
                        <div class="system-card-number">01</div>
                    </div>
                    <p class="system-card-description">
                        A complete HR and administration system for security companies. Manages employee onboarding, contracts, uniforms, and equipment with role-based access control.
                    </p>
                    <div class="system-card-features">
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Employee onboarding & management</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Contract creation & tracking</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Uniform & equipment management</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Role-based access control</span>
                        </div>
                    </div>
                    <div class="system-card-tech">
                        <span class="tech-pill">C#</span>
                        <span class="tech-pill">.NET Framework</span>
                        <span class="tech-pill">SQL Server</span>
                        <span class="tech-pill">WinForms</span>
                    </div>
                </div>

                <!-- System 2: Operations Room -->
                <div class="system-card reveal" style="--stagger-index:1">
                    <div class="system-card-header">
                        <div class="system-card-icon">📋</div>
                        <div class="system-card-info">
                            <h3>Operations Room System</h3>
                            <span class="system-card-category">.NET Framework · C#</span>
                        </div>
                        <div class="system-card-number">02</div>
                    </div>
                    <p class="system-card-description">
                        A powerful operations room system for managing client projects and contracts. Create, edit, delete, and archive contracts with real-time tracking.
                    </p>
                    <div class="system-card-features">
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Create new projects for clients</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Edit & update contract details</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Delete & archive contracts</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Real-time project tracking</span>
                        </div>
                    </div>
                    <div class="system-card-tech">
                        <span class="tech-pill">C#</span>
                        <span class="tech-pill">.NET Framework</span>
                        <span class="tech-pill">SQL Server</span>
                        <span class="tech-pill">CRUD</span>
                    </div>
                </div>

                <!-- System 3: Supermarket POS -->
                <div class="system-card reveal" style="--stagger-index:2">
                    <div class="system-card-header">
                        <div class="system-card-icon">🛒</div>
                        <div class="system-card-info">
                            <h3>Supermarket POS System</h3>
                            <span class="system-card-category">.NET Framework · C#</span>
                        </div>
                        <div class="system-card-number">03</div>
                    </div>
                    <p class="system-card-description">
                        A complete point-of-sale system for supermarkets with QR code scanning, automatic price display, and real-time inventory updates.
                    </p>
                    <div class="system-card-features">
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>QR code scanning for items</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Automatic price display</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Cash transaction processing</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Real-time inventory updates</span>
                        </div>
                    </div>
                    <div class="system-card-tech">
                        <span class="tech-pill">C#</span>
                        <span class="tech-pill">.NET Framework</span>
                        <span class="tech-pill">SQL Server</span>
                        <span class="tech-pill">QR Scanner</span>
                    </div>
                </div>

                <!-- System 4: Data Integration -->
                <div class="system-card reveal" style="--stagger-index:3">
                    <div class="system-card-header">
                        <div class="system-card-icon">🔗</div>
                        <div class="system-card-info">
                            <h3>Data Integration</h3>
                            <span class="system-card-category">.NET Framework · SQL</span>
                        </div>
                        <div class="system-card-number">04</div>
                    </div>
                    <p class="system-card-description">
                        Robust data integration layer connecting all systems with SQL Server, secure backups, and real-time synchronization across the entire platform.
                    </p>
                    <div class="system-card-features">
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>SQL Server database management</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Secure data backup & recovery</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>Real-time data synchronization</span>
                        </div>
                        <div class="feature-item">
                            <span class="feature-icon">✅</span>
                            <span>CRUD operations with .NET</span>
                        </div>
                    </div>
                    <div class="system-card-tech">
                        <span class="tech-pill">C#</span>
                        <span class="tech-pill">SQL Server</span>
                        <span class="tech-pill">Azure</span>
                        <span class="tech-pill">Sync</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== STATS SECTION ===== -->
    <section class="tools-stats-section section-tight">
        <div class="container">
            <div class="stats-banner reveal">
                <div class="stats-banner-grid">
                    <div class="stats-banner-item">
                        <span class="stats-banner-number">4</span>
                        <span class="stats-banner-label">Systems Built</span>
                    </div>
                    <div class="stats-banner-divider"></div>
                    <div class="stats-banner-item">
                        <span class="stats-banner-number">300+</span>
                        <span class="stats-banner-label">Users Supported</span>
                    </div>
                    <div class="stats-banner-divider"></div>
                    <div class="stats-banner-item">
                        <span class="stats-banner-number">100%</span>
                        <span class="stats-banner-label">Data Integrity</span>
                    </div>
                    <div class="stats-banner-divider"></div>
                    <div class="stats-banner-item">
                        <span class="stats-banner-number">24/7</span>
                        <span class="stats-banner-label">Operations</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="section-tight">
        <div class="container">
            <div class="reveal cta-banner">
                <span class="eyebrow" style="justify-content: center;">need-something-similar</span>
                <h2 style="font-size: 2rem;">Want a custom system<br>for <span class="grad-text">your business?</span></h2>
                <p style="max-width: 500px; margin: 0 auto var(--space-5);">Let's build software that streamlines your operations.</p>
                <a href="/contact" class="btn btn-primary">Start Your Project</a>
            </div>
        </div>
    </section>

</div>

<style>
    /* ===== TOOLS HERO ===== */
    .tools-hero {
        padding-top: var(--space-4);
    }

    .tools-hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: var(--space-8);
        align-items: center;
        min-height: 50vh;
    }

    .tools-hero-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .tools-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        background: rgba(0, 229, 255, 0.08);
        border: 1px solid rgba(0, 229, 255, 0.15);
        border-radius: 999px;
        padding: 6px 16px 6px 10px;
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--accent-cyan);
        width: fit-content;
        font-family: var(--font-mono);
    }

    .tools-headline {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: clamp(2.4rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .tools-line-gradient {
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .tools-description {
        font-size: 1.1rem;
        max-width: 480px;
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0;
    }

    .tools-stats {
        display: flex;
        align-items: center;
        gap: var(--space-6);
        padding-top: var(--space-4);
        border-top: 1px solid var(--border-subtle);
        margin-top: var(--space-2);
    }

    .tools-stat {
        display: flex;
        flex-direction: column;
    }

    .tools-stat-number {
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.01em;
    }

    .tools-stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        font-weight: 400;
    }

    .tools-stat-divider {
        width: 1px;
        height: 32px;
        background: var(--border-subtle);
    }

    /* ===== TOOLS VISUAL ===== */
    .tools-hero-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
    }

    .tools-orb {
        position: absolute;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle at center, rgba(0, 229, 255, 0.06), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: floatY 8s ease-in-out infinite;
    }

    .tools-icon-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4);
        position: relative;
        z-index: 1;
    }

    .tools-icon-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        width: 110px;
        height: 110px;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        transition: transform 0.4s var(--ease-out-expo), border-color 0.4s, box-shadow 0.4s;
        cursor: default;
    }

        .tools-icon-card:hover {
            transform: translateY(-8px) scale(1.05);
            border-color: var(--border-glow);
            box-shadow: 0 20px 60px rgba(0, 229, 255, 0.08);
        }

    .tools-icon {
        font-size: 2.4rem;
        line-height: 1;
    }

    .tools-icon-label {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        color: var(--text-muted);
        letter-spacing: 0.04em;
    }

    /* ===== SYSTEMS GRID ===== */
    .tools-systems {
        padding: var(--space-8) 0;
        background: rgba(0, 0, 0, 0.15);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
    }

    .systems-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-5);
        margin-top: var(--space-6);
    }

    .system-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        transition: transform 0.4s var(--ease-out-expo), border-color 0.4s, box-shadow 0.4s;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        position: relative;
        overflow: hidden;
    }

        .system-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: var(--accent-gradient);
            opacity: 0;
            transition: opacity 0.4s;
        }

        .system-card:hover::before {
            opacity: 1;
        }

        .system-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
        }

    .system-card-header {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
        position: relative;
    }

    .system-card-icon {
        font-size: 2rem;
        line-height: 1;
        flex-shrink: 0;
        width: 48px;
        text-align: center;
    }

    .system-card-info {
        flex: 1;
    }

        .system-card-info h3 {
            font-size: 1.1rem;
            margin: 0;
            font-family: var(--font-display);
            font-weight: 600;
        }

    .system-card-category {
        font-size: 0.72rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        display: block;
        margin-top: 2px;
    }

    .system-card-number {
        font-family: var(--font-mono);
        font-size: 2rem;
        font-weight: 700;
        color: var(--accent-cyan);
        opacity: 0.1;
        line-height: 1;
        flex-shrink: 0;
        position: absolute;
        right: 0;
        top: 0;
    }

    .system-card-description {
        font-size: 0.92rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0;
        padding-right: var(--space-2);
    }

    .system-card-features {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-1) var(--space-3);
        margin: var(--space-1) 0;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: var(--space-1);
        font-size: 0.82rem;
        color: var(--text-secondary);
        padding: 2px 0;
    }

    .feature-icon {
        font-size: 0.7rem;
        color: var(--success);
        flex-shrink: 0;
    }

    .system-card-tech {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
        margin-top: var(--space-1);
    }

    .tech-pill {
        font-size: 0.6rem;
        font-family: var(--font-mono);
        padding: 2px 10px;
        border-radius: 999px;
        border: 1px solid var(--border-subtle);
        color: var(--text-muted);
        background: rgba(0, 0, 0, 0.2);
    }

    /* ===== STATS BANNER ===== */
    .tools-stats-section {
        padding: var(--space-6) 0;
    }

    .stats-banner {
        background: var(--bg-surface);
        border: 1px solid var(--border-glow);
        border-radius: var(--radius-lg);
        padding: var(--space-6) var(--space-8);
        box-shadow: 0 0 40px rgba(0, 229, 255, 0.03);
    }

    .stats-banner-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
        align-items: center;
        text-align: center;
    }

    .stats-banner-item {
        display: flex;
        flex-direction: column;
    }

    .stats-banner-number {
        font-family: var(--font-display);
        font-size: 2.4rem;
        font-weight: 700;
        color: var(--accent-cyan);
        line-height: 1.1;
    }

    .stats-banner-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        font-weight: 400;
        margin-top: 4px;
    }

    .stats-banner-divider {
        width: 1px;
        height: 40px;
        background: var(--border-subtle);
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .tools-hero-grid {
            grid-template-columns: 1fr;
            min-height: auto;
            gap: var(--space-6);
        }

        .tools-hero-content {
            order: 1;
        }

        .tools-hero-visual {
            order: 0;
        }

        .tools-headline {
            font-size: clamp(2rem, 4vw, 2.8rem);
        }

        .tools-description {
            font-size: 1rem;
            max-width: 100%;
        }

        .systems-grid {
            grid-template-columns: 1fr 1fr;
        }

        .system-card-features {
            grid-template-columns: 1fr;
        }

        .stats-banner-grid {
            grid-template-columns: 1fr 1fr;
            gap: var(--space-4);
        }

        .stats-banner-divider {
            display: none;
        }

        .stats-banner {
            padding: var(--space-4);
        }
    }

    @@media (max-width: 768px) {
        .tools-stats {
            flex-wrap: wrap;
            gap: var(--space-4);
        }

        .tools-stat-divider {
            display: none;
        }

        .systems-grid {
            grid-template-columns: 1fr;
        }

        .tools-icon-card {
            width: 80px;
            height: 80px;
        }

        .tools-icon {
            font-size: 1.8rem;
        }

        .tools-orb {
            width: 250px;
            height: 250px;
        }

        .system-card-number {
            font-size: 1.4rem;
        }

        .stats-banner-grid {
            grid-template-columns: 1fr 1fr;
            gap: var(--space-3);
        }

        .stats-banner-number {
            font-size: 1.8rem;
        }
    }

    @@media (max-width: 480px) {
        .tools-stats {
            flex-direction: column;
            align-items: flex-start;
        }

        .tools-icon-grid {
            gap: var(--space-2);
        }

        .tools-icon-card {
            width: 60px;
            height: 60px;
        }

        .tools-icon {
            font-size: 1.4rem;
        }

        .tools-icon-label {
            font-size: 0.55rem;
        }

        .system-card {
            padding: var(--space-4);
        }

        .system-card-header {
            flex-wrap: wrap;
        }

        .system-card-number {
            position: static;
            font-size: 1.2rem;
        }

        .stats-banner-grid {
            grid-template-columns: 1fr 1fr;
            gap: var(--space-2);
        }

        .stats-banner {
            padding: var(--space-3);
        }

        .stats-banner-number {
            font-size: 1.4rem;
        }

        .stats-banner-label {
            font-size: 0.65rem;
        }
    }
</style>

@code {
    // No JavaScript needed - handled by site.js
}