@page "/contact"
@using Microsoft.AspNetCore.Components.Forms
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer
@inject IConfiguration Config
@using System.Net
@using System.Net.Mail
@using System.ComponentModel.DataAnnotations

@* Replace SeoHead with a simple div or remove it if the component doesn't exist *@
<div class="eyebrow" style="margin-bottom: var(--space-3);">contact</div>

<div class="page-enter section">
    <div class="container contact-grid">
        <!-- Left column -->
        <div class="reveal reveal-left" style="--stagger-index:0">
            <h1>Let's build something.</h1>
            <p>
                Tell me what you need — a business website, a mobile app, or a management system — and I'll get
                back to you within a day.
            </p>
            <p><a href="mailto:aliabdulsameea69@gmail.com">aliabdulsameea69@gmail.com</a></p>
            <p><a href="tel:+12893391367">+1 289 339 1367</a></p>

            <!-- Extra social/trust signals -->
            <div class="stat-strip" style="justify-content: flex-start; gap: var(--space-6); padding: var(--space-5) 0 0;">
                <div class="stat"><strong>24h</strong><span>reply time</span></div>
                <div class="stat"><strong>5+</strong><span>years exp.</span></div>
            </div>
        </div>

        <!-- Right column - contact form -->
        <div class="reveal reveal-right" style="--stagger-index:1">
            <div class="card hover-lift">
                @if (submitted)
                {
                    <div style="text-align:center; padding: var(--space-6) 0;">
                        <div style="font-size:3rem; margin-bottom:var(--space-4);">✅</div>
                        <h3>Message sent.</h3>
                        <p style="color:var(--text-secondary);">Thanks — I'll reply within a day.</p>
                        <button class="btn btn-ghost" @onclick="ResetForm" style="margin-top:var(--space-4);">Send another message</button>
                    </div>
                }
                else
                {
                    <EditForm Model="@form" OnValidSubmit="HandleSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <label>Name</label>
                        <InputText @bind-Value="form.Name" class="input" />
                        <ValidationMessage For="@(() => form.Name)" />

                        <label>Email</label>
                        <InputText @bind-Value="form.Email" class="input" />
                        <ValidationMessage For="@(() => form.Email)" />

                        <label>Phone</label>
                        <div class="phone-row">
                            <select @bind="form.CountryCode" class="input phone-code">
                                @foreach (var country in Countries)
                                {
                                    <option value="@country.Code">@country.Flag @country.Code</option>
                                }
                            </select>
                            <InputText @bind-Value="form.PhoneNumber" class="input phone-number" placeholder="289 339 1367" />
                        </div>
                        <ValidationMessage For="@(() => form.PhoneNumber)" />

                        <label>Country</label>
                        <InputSelect @bind-Value="form.Country" class="input">
                            <option value="" disabled selected>Select your country</option>
                            @foreach (var country in Countries)
                            {
                                <option value="@country.Name">@country.Flag @country.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => form.Country)" />

                        <label>City / Address</label>
                        <InputText @bind-Value="form.Address" class="input" placeholder="City, street (optional detail)" />
                        <ValidationMessage For="@(() => form.Address)" />

                        <label>What do you need?</label>
                        <InputTextArea @bind-Value="form.Message" class="input" rows="4" placeholder="Website, mobile app, management system..." />
                        <ValidationMessage For="@(() => form.Message)" />

                        @if (errorMessage is not null)
                        {
                            <p style="color:var(--warning); margin-top: var(--space-3);">@errorMessage</p>
                        }

                        <button type="submit" class="btn btn-primary" disabled="@sending" style="margin-top: var(--space-4); width:100%; justify-content:center;">
                            @(sending ? "Sending..." : "Send Message →")
                        </button>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>



<style>
    /* ===== animations & base styles (matching home page) ===== */
    :root {
        --bg-void: #050810;
        --bg-surface: #0B0F1A;
        --bg-elevated: #121A2B;
        --border-subtle: #1C2436;
        --border-glow: rgba(0, 229, 255, 0.35);
        --accent-cyan: #00E5FF;
        --accent-blue: #3D7FFF;
        --accent-gradient: linear-gradient(135deg, #00E5FF 0%, #3D7FFF 100%);
        --text-primary: #EAF0F7;
        --text-secondary: #A7B2C4;
        --text-muted: #5E6B82;
        --success: #3DDC97;
        --warning: #FFB020;
        --font-display: 'Space Grotesk', sans-serif;
        --font-body: 'Inter', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        --space-1: 4px;
        --space-2: 8px;
        --space-3: 12px;
        --space-4: 16px;
        --space-5: 24px;
        --space-6: 32px;
        --space-7: 48px;
        --space-8: 64px;
        --space-9: 96px;
        --space-10: 128px;
        --radius-sm: 6px;
        --radius-md: 12px;
        --radius-lg: 20px;
        --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
        --dur-fast: 200ms;
        --dur-med: 500ms;
        --dur-slow: 900ms;
        --content-width: 1180px;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(28px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes gradientShift {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity var(--dur-slow) var(--ease-out-expo), transform var(--dur-slow) var(--ease-out-expo);
        animation: fadeInUp 1s var(--ease-out-expo) 0.8s forwards;
    }

    .reveal-left {
        transform: translateX(-32px);
        animation: fadeInUp 1s var(--ease-out-expo) 0.8s forwards;
    }

        .reveal-left.is-visible,
        .reveal-left {
            opacity: 1;
            transform: translateX(0);
        }

    .reveal-right {
        transform: translateX(32px);
        animation: fadeInUp 1s var(--ease-out-expo) 1s forwards;
    }

        .reveal-right.is-visible,
        .reveal-right {
            opacity: 1;
            transform: translateX(0);
        }

    .page-enter {
        animation: fadeInUp var(--dur-med) var(--ease-out-expo);
    }

    .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.82rem;
        color: var(--accent-cyan);
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-3);
        letter-spacing: 0.02em;
    }

        .eyebrow::before {
            content: "~/";
            color: var(--text-muted);
        }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.95rem;
        padding: 13px 26px;
        border-radius: var(--radius-md);
        border: 1px solid transparent;
        cursor: pointer;
        transition: transform var(--dur-fast) var(--ease-out-expo), box-shadow var(--dur-fast), background var(--dur-fast);
    }

    .btn-primary {
        background: var(--accent-gradient);
        background-size: 200% 200%;
        color: #04121a;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 229, 255, 0.28);
            animation: gradientShift 3s ease infinite;
        }

    .btn-ghost {
        background: transparent;
        border-color: var(--border-subtle);
        color: var(--text-primary);
    }

        .btn-ghost:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
            transform: translateY(-2px);
        }

    .card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        transition: transform var(--dur-med) var(--ease-out-expo), border-color var(--dur-med), box-shadow var(--dur-med);
    }

        .card:hover {
            transform: translateY(-4px);
            border-color: var(--border-glow);
            box-shadow: 0 20px 50px rgba(0,0,0,0.35), 0 0 0 1px rgba(0,229,255,0.08);
        }

    .hover-lift {
        transition: transform 0.25s var(--ease-out-expo), box-shadow 0.3s;
    }

        .hover-lift:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0, 229, 255, 0.08);
        }

    .container {
        width: 100%;
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 0 var(--space-5);
    }

    .section {
        padding: var(--space-7) 0;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-8);
        align-items: start;
    }

    h1 {
        font-family: var(--font-display);
        font-weight: 600;
        line-height: 1.1;
        margin: 0 0 var(--space-4);
        letter-spacing: -0.01em;
        font-size: clamp(2.4rem, 5vw, 4.2rem);
    }

    h3 {
        font-family: var(--font-display);
        font-weight: 600;
        line-height: 1.1;
        margin: 0 0 var(--space-4);
        letter-spacing: -0.01em;
        font-size: clamp(1.2rem, 2vw, 1.5rem);
    }

    p {
        color: var(--text-secondary);
        margin: 0 0 var(--space-4);
    }

    a {
        color: var(--accent-cyan);
        text-decoration: none;
    }

    label {
        display: block;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin: var(--space-4) 0 var(--space-2);
    }

    .input {
        width: 100%;
        padding: 12px 14px;
        background: var(--bg-elevated);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        font-family: var(--font-body);
    }

        .input:focus {
            outline: none;
            border-color: var(--accent-cyan);
        }

    select.input {
        appearance: none;
        background-image: linear-gradient(45deg, transparent 50%, var(--text-muted) 50%), linear-gradient(135deg, var(--text-muted) 50%, transparent 50%);
        background-position: calc(100% - 18px) center, calc(100% - 13px) center;
        background-size: 5px 5px, 5px 5px;
        background-repeat: no-repeat;
    }

        select.input option {
            background: var(--bg-elevated);
            color: var(--text-primary);
        }

    .phone-row {
        display: flex;
        gap: var(--space-3);
    }

    .phone-code {
        flex: 0 0 140px;
    }

    .phone-number {
        flex: 1;
    }

    .stat-strip {
        display: flex;
        text-align: center;
        padding: var(--space-4) 0;
    }

    .stat strong {
        display: block;
        font-family: var(--font-display);
        font-size: 2rem;
        color: var(--accent-cyan);
    }

    .stat span {
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .validation-message {
        color: var(--warning);
        font-size: 0.82rem;
        margin-top: 4px;
        display: block;
    }

    @@media (max-width: 900px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {
        .phone-row {
            flex-direction: column;
        }

        .phone-code {
            flex: 1;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .reveal, .reveal-left, .reveal-right, .page-enter {
            animation: none !important;
            transition: none !important;
            opacity: 1 !important;
            transform: none !important;
        }
    }
</style>
<AiChat />
@code {
    private ContactForm form = new();
    private bool submitted = false;
    private bool sending = false;
    private string? errorMessage;

    private void ResetForm()
    {
        submitted = false;
        form = new ContactForm();
        errorMessage = null;
    }

    private async Task HandleSubmit()
    {
        sending = true;
        errorMessage = null;

        try
        {
            // ===== DEBUG: Check if config is being read =====
            var username = Config["EmailSettings:Username"] ?? "NOT FOUND";
            var password = Config["EmailSettings:Password"] ?? "NOT FOUND";

            Console.WriteLine($"=== CONTACT FORM DEBUG ===");
            Console.WriteLine($"Username from config: {username}");
            Console.WriteLine($"Password from config: {password}");
            Console.WriteLine($"===========================");

            if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
            {
                errorMessage = "Email isn't configured yet — please email me directly instead.";
                return;
            }

            using var client = new SmtpClient("smtp.gmail.com", 587)
            {
                Credentials = new NetworkCredential(username, password),
                EnableSsl = true
            };

            var fullPhone = $"{form.CountryCode} {form.PhoneNumber}";

            var mail = new MailMessage
            {
                From = new MailAddress(username, "CrossPlatformDev Contact Form"),
                Subject = $"New inquiry from {form.Name}",
                Body = $"Name: {form.Name}\n" +
                       $"Email: {form.Email}\n" +
                       $"Phone: {fullPhone}\n" +
                       $"Country: {form.Country}\n" +
                       $"Address: {form.Address}\n\n" +
                       $"Message:\n{form.Message}",
                IsBodyHtml = false
            };
            mail.To.Add(username);
            mail.ReplyToList.Add(new MailAddress(form.Email));

            await client.SendMailAsync(mail);
            submitted = true;
        }
        catch (Exception ex)
        {
            errorMessage = "Something went wrong sending your message — try emailing directly instead.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            sending = false;
        }
    }


    private void HandleInvalidSubmit()
    {
        errorMessage = "Please fill in all fields correctly before sending.";
    }

    public class ContactForm
    {
        [Required(ErrorMessage = "Please enter your name.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Please select your country.")]
        public string Country { get; set; } = "";

        [Required(ErrorMessage = "Please enter your email.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email.")]
        public string Email { get; set; } = "";

        public string CountryCode { get; set; } = "+1";

        [Required(ErrorMessage = "Please enter your phone number.")]
        [Phone(ErrorMessage = "Please enter a valid phone number.")]
        public string PhoneNumber { get; set; } = "";

        [Required(ErrorMessage = "Please enter your address.")]
        public string Address { get; set; } = "";

