@page "/contact"
@rendermode InteractiveServer
@inject IConfiguration Config
@using System.Net
@using System.Net.Mail
@using System.ComponentModel.DataAnnotations

<SeoHead Title="Contact — CrossPlatformDev"
         Description="Start a website, mobile app, or business system project with CrossPlatformDev."
         Path="/contact" />

<div class="page-enter section">
    <div class="container contact-grid">
        <AnimatedSection Variant="reveal-left">
            <SectionEyebrow Text="contact" />
            <h1>Let's build something.</h1>
            <p>
                Tell me what you need — a business website, a mobile app, or a management system — and I'll get
                back to you within a day.
            </p>
            <p><a href="mailto:aliabdulsameea69@gmail.com">aliabdulsameea69@gmail.com</a></p>
            <p><a href="tel:+12893391367">+1 289 339 1367</a></p>
        </AnimatedSection>

        <AnimatedSection Variant="reveal-right">
            <div class="card">
                @if (submitted)
                {
                    <h3>Message sent.</h3>
                    <p>Thanks — I'll reply within a day.</p>
                }
                else
                {
                    <EditForm Model="@form" OnValidSubmit="HandleSubmit" OnInvalidSubmit="HandleInvalidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <label>Name</label>
                        <InputText @bind-Value="form.Name" class="input" />
                        <ValidationMessage For="@(() => form.Name)" />

                        <label>Email</label>
                        <InputText @bind-Value="form.Email" class="input" />
                        <ValidationMessage For="@(() => form.Email)" />

                        <label>Phone</label>
                        <div class="phone-row">
                            <select @bind="form.CountryCode" class="input phone-code">
                                @foreach (var country in Countries)
                                {
                                    <option value="@country.Code">@country.Flag @country.Code (@country.Name)</option>
                                }
                            </select>
                            <InputText @bind-Value="form.PhoneNumber" class="input phone-number" placeholder="289 339 1367" />
                        </div>
                        <ValidationMessage For="@(() => form.PhoneNumber)" />

                        <label>Country</label>
                        <InputSelect @bind-Value="form.Country" class="input">
                            <option value="" disabled selected>Select your country</option>
                            @foreach (var country in Countries)
                            {
                                <option value="@country.Name">@country.Flag @country.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => form.Country)" />

                        <label>City / Address</label>
                        <InputText @bind-Value="form.Address" class="input" placeholder="City, street (optional detail)" />
                        <ValidationMessage For="@(() => form.Address)" />

                        <label>What do you need?</label>
                        <InputTextArea @bind-Value="form.Message" class="input" rows="4" placeholder="Website, mobile app, management system..." />
                        <ValidationMessage For="@(() => form.Message)" />

                        @if (errorMessage is not null)
                        {
                            <p style="color:var(--warning)">@errorMessage</p>
                        }

                        <button type="submit" class="btn btn-primary" disabled="@sending">
                            @(sending ? "Sending..." : "Send Message")
                        </button>
                    </EditForm>
                }
            </div>
        </AnimatedSection>
    </div>
</div>

@code {
    private ContactForm form = new();
    private bool submitted = false;
    private bool sending = false;
    private string? errorMessage;

    private async Task HandleSubmit()
    {
        sending = true;
        errorMessage = null;

        try
        {
            var username = Config["EmailSettings:Username"];
            var password = Config["EmailSettings:Password"];

            if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
            {
                errorMessage = "Email isn't configured yet — please email me directly instead.";
                return;
            }

            using var client = new SmtpClient("smtp.gmail.com", 587)
            {
                Credentials = new NetworkCredential(username, password),
                EnableSsl = true
            };

            var fullPhone = $"{form.CountryCode} {form.PhoneNumber}";

            var mail = new MailMessage
            {
                From = new MailAddress(username, "CrossPlatformDev Contact Form"),
                Subject = $"New inquiry from {form.Name}",
                Body = $"Name: {form.Name}\n" +
       $"Email: {form.Email}\n" +
       $"Phone: {fullPhone}\n" +
       $"Country: {form.Country}\n" +
       $"Address: {form.Address}\n\n" +
       $"Message:\n{form.Message}",
                IsBodyHtml = false
            };
            mail.To.Add(username);
            mail.ReplyToList.Add(new MailAddress(form.Email));

            await client.SendMailAsync(mail);
            submitted = true;
        }
        catch (Exception)
        {
            errorMessage = "Something went wrong sending your message — try emailing directly instead.";
        }
        finally
        {
            sending = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        errorMessage = "Please fill in all fields correctly before sending.";
    }

    public class ContactForm
    {
        [Required(ErrorMessage = "Please enter your name.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Please select your country.")]
        public string Country { get; set; } = "";

        [Required(ErrorMessage = "Please enter your email.")]
        [EmailAddress(ErrorMessage = "Please enter a valid email.")]
        public string Email { get; set; } = "";

        public string CountryCode { get; set; } = "+1";

        [Required(ErrorMessage = "Please enter your phone number.")]
        [Phone(ErrorMessage = "Please enter a valid phone number.")]
        public string PhoneNumber { get; set; } = "";

        [Required(ErrorMessage = "Please enter your address.")]
        public string Address { get; set; } = "";

        [Required(ErrorMessage = "Please tell me what you need.")]
        public string Message { get; set; } = "";
    }

