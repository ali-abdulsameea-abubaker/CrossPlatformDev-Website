@page "/"

<SeoHead Title="CrossPlatformDev — Custom Websites, Mobile Apps & Business Systems"
         Description="Custom website development, mobile app development, and business management systems (POS, inventory, supermarket systems). 5+ years full-stack experience."
         Path="/" />

<div class="page-enter">

    <section class="hero section">
        <div class="container hero-grid">
            <div>





           
                    <span class="eyebrow">home</span>
                    <h1 class="hero-title">
                        <span class="reveal-word" style="--i:0">Websites,</span>
                        <span class="reveal-word" style="--i:1">apps,</span>
                        <span class="reveal-word" style="--i:2">and</span>
                        <span class="reveal-word" style="--i:3">business</span>
                        <span class="reveal-word" style="--i:4">systems</span>
                        <span class="reveal-word" style="--i:5">that</span>
                        <span class="reveal-word" style="--i:6">actually</span>
                        <span class="reveal-word reveal-word-accent" style="--i:7">ship.</span>
                    </h1>
                    <p class="hero-sub">
                        I'm Ali Abubaker, a full-stack developer with 5+ years building production
                        software — from business websites to Android apps to custom management systems for
                        supermarkets and retail operations. If your business needs software that works, this is
                        where it gets built.
                    </p>
                    <div class="hero-actions">
                        <a href="/contact" class="btn btn-primary">Start a Project</a>
                        <a href="/portfolio" class="btn btn-ghost">View Work</a>
                    </div>
                </div>
            <div class="floaty">
                <TerminalHero />
            </div>
        </div>
    </section>

    <section class="section-tight">
        <div class="container">
            <AnimatedSection>
                <SectionEyebrow Text="what-i-build" />
                <h2>One developer, every layer of your product.</h2>
            </AnimatedSection>

            <div class="grid-3">
                <AnimatedSection StaggerIndex="0">
                    <ServiceCard Icon="🌐" Title="Website Development"
                                 Description="Business websites, landing pages, and web apps built with modern frameworks — fast, responsive, and easy for you to update."
                                 Tags='new[]{"Business Websites","Landing Pages","Web Apps"}' />
                </AnimatedSection>
                <AnimatedSection StaggerIndex="1">
                    <ServiceCard Icon="📱" Title="Mobile & Android Apps"
                                 Description="Native and cross-platform mobile applications for Android and iOS, from concept through app store launch."
                                 Tags='new[]{"Android","Cross-Platform","App Store"}' />
                </AnimatedSection>
                <AnimatedSection StaggerIndex="2">
                    <ServiceCard Icon="🖥️" Title="Business Management Systems"
                                 Description="Custom systems for real operations — inventory, POS, and management software built for supermarkets and growing businesses."
                                 Tags='new[]{"Inventory","POS","Supermarket Systems"}' />
                </AnimatedSection>
            </div>
        </div>
    </section>

    <section class="section-tight">
        <div class="container">
            <AnimatedSection Variant="reveal-scale" CssClass="stat-strip">
                <div class="stat"><strong>5+</strong><span>Years Experience</span></div>
                <div class="stat"><strong>300+</strong><span>Support Cases Resolved</span></div>
                <div class="stat"><strong>100%</strong><span>Test Coverage on Capstone Project</span></div>
            </AnimatedSection>
        </div>
    </section>

    <section class="section-tight">
        <div class="container">
            <AnimatedSection>
                <CtaBanner />
            </AnimatedSection>
        </div>
    </section>

</div>