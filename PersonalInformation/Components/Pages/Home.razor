@page "/"
@inject IJSRuntime JS

<SeoHead Title="CrossPlatformDev — Custom Websites, Mobile Apps & Business Systems"
         Description="Custom website development, mobile apps, and business management systems for growing businesses. 5+ years of full-stack experience."
         Path="/" />

<div class="page-enter">

    <!-- ===== HERO SECTION ===== -->
    <section class="hero section">
        <div class="container">
            <div class="hero-grid-new">
                <div class="hero-content">
                    <div class="hero-badge reveal" style="--stagger-index:0">
                        <span class="badge-dot"></span>
                        <span>Available for projects</span>
                    </div>
                    <h1 class="hero-headline reveal" style="--stagger-index:1">
                        <span class="hero-line">Building software that actually works.</span>
                    </h1>
                    <p class="hero-description reveal" style="--stagger-index:2">
                        I'm Ali Abubaker — full-stack developer with 5+ years of experience.
                        I build websites, mobile apps, and business systems that ship on time
                        and solve real problems.
                    </p>
                    <div class="hero-actions-new reveal" style="--stagger-index:3">
                        <a href="/contact" class="btn btn-primary btn-large">
                            <span>Start a Project</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                        </a>
                        <a href="/portfolio" class="btn btn-ghost btn-large">View Work</a>
                    </div>
                    <div class="hero-trust reveal" style="--stagger-index:4">
                        <div class="trust-item">
                            <span class="trust-number">5+</span>
                            <span class="trust-label">Years Experience</span>
                        </div>
                        <div class="trust-divider"></div>
                        <div class="trust-item">
                            <span class="trust-number">300+</span>
                            <span class="trust-label">Support Cases</span>
                        </div>
                        <div class="trust-divider"></div>
                        <div class="trust-item">
                            <span class="trust-number">100%</span>
                            <span class="trust-label">Test Coverage</span>
                        </div>
                    </div>
                </div>

                <div class="hero-visual reveal" style="--stagger-index:2">
                    <div class="hero-orb"></div>
                    <div class="hero-code-block">
                        <div class="code-header">
                            <span class="code-dot red"></span>
                            <span class="code-dot yellow"></span>
                            <span class="code-dot green"></span>
                            <span class="code-title">developer@ali ~/portfolio</span>
                            <span class="code-branch">main</span>
                            <span class="code-status">●</span>
                        </div>
                        <div class="code-body" id="code-body">
                            <!-- Content populated by JavaScript typing effect -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== SERVICES ===== -->
    <section class="section-tight">
        <div class="container">
            <!-- NEW: Redesigned Section Header -->
            <div class="section-header-modern reveal">
                <div class="section-label">
                    <span class="label-line"></span>
                    <span class="label-text">What I Build</span>
                    <span class="label-line"></span>
                </div>
                <h2 class="section-title">One developer, <span class="grad-text">every layer of your product.</span></h2>
                <p class="section-subtitle">From websites to mobile apps to full business systems — I build software that ships.</p>
            </div>

            <div class="grid-3">
                <div class="reveal card hover-lift" style="--stagger-index:0">
                    <div class="card-icon">🌐</div>
                    <h3>Website Development</h3>
                    <p>Business websites, landing pages, and web apps built with modern frameworks — fast, responsive, and easy to update.</p>
                    <div class="tag-row">
                        <span class="pill">Business Websites</span>
                        <span class="pill">Landing Pages</span>
                        <span class="pill">Web Apps</span>
                    </div>
                </div>
                <div class="reveal card hover-lift" style="--stagger-index:1">
                    <div class="card-icon">📱</div>
                    <h3>Mobile & Android Apps</h3>
                    <p>Native and cross-platform mobile applications for Android and iOS, from concept through app store launch.</p>
                    <div class="tag-row">
                        <span class="pill">Android</span>
                        <span class="pill">Cross-Platform</span>
                        <span class="pill">App Store</span>
                    </div>
                </div>
                <div class="reveal card hover-lift" style="--stagger-index:2">
                    <div class="card-icon">🖥️</div>
                    <h3>Business Management Systems</h3>
                    <p>Custom systems for real operations — inventory, POS, and management software built for supermarkets and growing businesses.</p>
                    <div class="tag-row">
                        <span class="pill">Inventory</span>
                        <span class="pill">POS</span>
                        <span class="pill">Supermarket Systems</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="section-tight">
        <div class="container">
            <div class="reveal cta-banner-modern">
                <!-- NEW: Redesigned CTA Label -->
                <div class="cta-label">
                    <span class="cta-label-line"></span>
                    <span class="cta-label-text">Ready to Build</span>
                    <span class="cta-label-line"></span>
                </div>
                <h2 class="cta-title">Let's turn your idea into <span class="grad-text">working software</span>.</h2>
                <p class="cta-description">From websites to full business systems — I build software that actually ships.</p>
                <a href="/contact" class="btn btn-primary btn-large cta-button">
                    <span>Start a Project</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                </a>
            </div>
        </div>
    </section>

</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initHomePage");
        }
    }
}