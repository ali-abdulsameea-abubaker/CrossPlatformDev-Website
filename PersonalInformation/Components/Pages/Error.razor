@page "/Error"
@using System.Diagnostics

<SeoHead Title="Error — CrossPlatformDev"
         Description="Something went wrong. Please try again or contact us for help."
         Path="/Error" />

<div class="page-enter">
    <div class="error-container section">
        <div class="container">
            <div class="error-grid">
                <div class="error-content">
                    <div class="error-badge">
                        <span class="error-icon">⚠️</span>
                        <span>Error</span>
                    </div>
                    <h1 class="error-title">Something went wrong</h1>
                    <p class="error-description">
                        An unexpected error occurred while processing your request.
                        Please try again or contact us if the problem persists.
                    </p>

                    @if (ShowRequestId)
                    {
                        <div class="error-request-id">
                            <span>Request ID:</span>
                            <code>@RequestId</code>
                            <button class="copy-id-btn" @onclick="CopyRequestId" title="Copy Request ID">
                                📋
                            </button>
                        </div>
                    }

                    <div class="error-actions">
                        <a href="/" class="btn btn-primary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="19" y1="12" x2="5" y2="12" />
                                <polyline points="12 19 5 12 12 5" />
                            </svg>
                            Go Back Home
                        </a>
                        <button class="btn btn-ghost" @onclick="RefreshPage">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="23 4 23 10 17 10" />
                                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
                            </svg>
                            Try Again
                        </button>
                    </div>

                    <div class="error-help">
                        <p>Need help? <a href="/contact">Contact me directly</a> and I'll look into it.</p>
                    </div>
                </div>
                <div class="error-visual">
                    <div class="error-orb"></div>
                    <div class="error-code-display">
                        <span class="error-code-number">500</span>
                        <span class="error-code-label">Server Error</span>
                    </div>
                </div>
            </div>

            <!-- Development Mode Info (only shown in dev) -->
            @if (ShowDevInfo)
            {
                <div class="dev-info">
                    <h3>🔧 Development Mode</h3>
                    <p>
                        Swapping to <strong>Development</strong> environment will display more detailed
                        information about the error that occurred.
                    </p>
                    <p>
                        <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
                        It can result in displaying sensitive information from exceptions to end users.
                        For local debugging, enable the <strong>Development</strong> environment by setting the
                        <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
                        and restarting the app.
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .error-container {
        padding: var(--space-8) 0;
        min-height: 70vh;
        display: flex;
        align-items: center;
    }

    .error-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: var(--space-8);
        align-items: center;
    }

    .error-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .error-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--warning);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 4px 0;
    }

    .error-icon {
        font-size: 1.2rem;
    }

    .error-title {
        font-size: clamp(2.4rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
        color: var(--text-primary);
    }

    .error-description {
        font-size: 1.1rem;
        color: var(--text-secondary);
        line-height: 1.7;
        max-width: 480px;
        margin: 0;
    }

    .error-request-id {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: 0.85rem;
        color: var(--text-muted);
        padding: var(--space-2) var(--space-3);
        background: var(--bg-elevated);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-subtle);
        width: fit-content;
    }

        .error-request-id code {
            font-family: var(--font-mono);
            color: var(--text-secondary);
            font-size: 0.8rem;
        }

    .copy-id-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.9rem;
        padding: 2px 6px;
        border-radius: var(--radius-sm);
        transition: background 0.2s;
    }

        .copy-id-btn:hover {
            background: var(--bg-hover);
        }

    .error-actions {
        display: flex;
        gap: var(--space-4);
        flex-wrap: wrap;
        margin-top: var(--space-2);
    }

    .error-help {
        padding-top: var(--space-3);
        border-top: 1px solid var(--border-subtle);
        font-size: 0.95rem;
    }

        .error-help p {
            margin: 0;
            color: var(--text-muted);
        }

        .error-help a {
            color: var(--accent-cyan);
        }

    /* ===== VISUAL ===== */
    .error-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
    }

    .error-orb {
        position: absolute;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle at center, rgba(255, 176, 32, 0.06), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: floatY 8s ease-in-out infinite;
    }

    .error-code-display {
        position: relative;
        z-index: 1;
        text-align: center;
    }

    .error-code-number {
        display: block;
        font-family: var(--font-display);
        font-size: 6rem;
        font-weight: 700;
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        line-height: 1;
        letter-spacing: -0.02em;
    }

    .error-code-label {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--text-muted);
        letter-spacing: 0.04em;
        display: block;
        margin-top: var(--space-1);
    }

    /* ===== DEV INFO ===== */
    .dev-info {
        margin-top: var(--space-8);
        padding: var(--space-5);
        background: var(--bg-elevated);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
    }

        .dev-info h3 {
            font-size: 1.1rem;
            margin: 0 0 var(--space-2);
            color: var(--warning);
        }

        .dev-info p {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin: 0 0 var(--space-2);
        }

            .dev-info p:last-child {
                margin-bottom: 0;
            }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .error-grid {
            grid-template-columns: 1fr;
            gap: var(--space-6);
        }

        .error-visual {
            order: 0;
            min-height: 200px;
        }

        .error-content {
            order: 1;
        }

        .error-code-number {
            font-size: 4rem;
        }

        .error-orb {
            width: 250px;
            height: 250px;
        }
    }

    @@media (max-width: 600px) {
        .error-actions {
            flex-direction: column;
        }

            .error-actions .btn {
                width: 100%;
                justify-content: center;
            }

        .error-title {
            font-size: clamp(1.8rem, 5vw, 2.4rem);
        }

        .error-description {
            font-size: 1rem;
        }

        .error-code-number {
            font-size: 3rem;
        }

        .error-request-id {
            flex-wrap: wrap;
        }
    }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private bool ShowDevInfo => !AppEnvironment.IsProduction();

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    private async Task CopyRequestId()
    {
        if (!string.IsNullOrEmpty(RequestId))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", RequestId);
            // Optional: Show a toast notification
        }
    }

    private void RefreshPage()
    {
        JS.InvokeVoidAsync("location.reload");
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private IWebHostEnvironment AppEnvironment { get; set; } = default!;
}