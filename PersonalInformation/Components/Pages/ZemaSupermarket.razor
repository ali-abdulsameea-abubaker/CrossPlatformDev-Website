@page "/portfolio/zema-supermarket"
@page "/zema-supermarket"

<div class="page-enter">

    <!-- ===== HERO SECTION ===== -->
    <section class="zema-hero section">
        <div class="container">
            <div class="zema-hero-grid">
                <div class="zema-hero-content">
                    <div class="zema-badge reveal" style="--stagger-index:0">
                        <span class="badge-dot"></span>
                        <span>Client Project</span>
                    </div>
                    <h1 class="zema-headline reveal" style="--stagger-index:1">
                        <span class="zema-line">Zema Mexican</span>
                        <span class="zema-line zema-line-gradient">Supermarket</span>
                    </h1>
                    <p class="zema-description reveal" style="--stagger-index:2">
                        A full-featured e-commerce platform for Zema Mexican Supermarket with online ordering,
                        secure payments, location-based delivery, and a powerful admin dashboard.
                    </p>
                    <div class="zema-stats reveal" style="--stagger-index:3">
                        <div class="zema-stat">
                            <span class="zema-stat-number">200+</span>
                            <span class="zema-stat-label">Products</span>
                        </div>
                        <div class="zema-stat-divider"></div>
                        <div class="zema-stat">
                            <span class="zema-stat-number">100%</span>
                            <span class="zema-stat-label">Online Payments</span>
                        </div>
                        <div class="zema-stat-divider"></div>
                        <div class="zema-stat">
                            <span class="zema-stat-number">Years</span>
                            <span class="zema-stat-label">Running Smoothly</span>
                        </div>
                    </div>
                </div>
                <div class="zema-hero-visual reveal" style="--stagger-index:2">
                    <div class="zema-orb"></div>
                    <div class="zema-icon-display">
                        <div class="zema-icon-circle">
                            <span class="zema-icon-large">🛒</span>
                        </div>
                        <div class="zema-icon-ring">
                            <span class="zema-ring-icon" style="top: -10%; left: 50%;">📍</span>
                            <span class="zema-ring-icon" style="bottom: -10%; left: 30%;">💳</span>
                            <span class="zema-ring-icon" style="bottom: -10%; right: 30%;">👤</span>
                            <span class="zema-ring-icon" style="top: -10%; right: 10%;">📦</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== OVERVIEW ===== -->
    <section class="zema-overview section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">overview</span>
                <h2>About the <span class="grad-text">Project</span></h2>
            </div>

            <div class="overview-grid">
                <div class="overview-card reveal" style="--stagger-index:0">
                    <div class="overview-icon">🌮</div>
                    <h4>Zema Mexican Supermarket</h4>
                    <p>A complete online grocery store built for a Mexican supermarket in Hamilton, ON. Customers can browse, order, and pay online with location-based delivery restrictions.</p>
                </div>
                <div class="overview-card reveal" style="--stagger-index:1">
                    <div class="overview-icon">⚙️</div>
                    <h4>Tech Stack</h4>
                    <div class="tech-tag-group">
                        <span class="tech-tag">Node.js</span>
                        <span class="tech-tag">Express</span>
                        <span class="tech-tag">MySQL</span>
                        <span class="tech-tag">HTML5</span>
                        <span class="tech-tag">CSS3</span>
                        <span class="tech-tag">JavaScript</span>
                        <span class="tech-tag">Stripe</span>
                        <span class="tech-tag">Bootstrap</span>
                    </div>
                </div>
                <div class="overview-card reveal" style="--stagger-index:2">
                    <div class="overview-icon">📊</div>
                    <h4>Key Metrics</h4>
                    <ul class="metrics-list">
                        <li>✅ 200+ products</li>
                        <li>✅ Secure payments</li>
                        <li>✅ Location-based delivery</li>
                        <li>✅ User accounts</li>
                        <li>✅ Admin dashboard</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== FEATURES ===== -->
    <section class="zema-features section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">features</span>
                <h2>What the <span class="grad-text">Platform Offers</span></h2>
            </div>

            <div class="features-grid">
                <div class="feature-card reveal" style="--stagger-index:0">
                    <div class="feature-icon-large">📍</div>
                    <h4>Location-Based Delivery</h4>
                    <p>Customers can only purchase items if they are within the delivery zone. This ensures efficient delivery and happy customers.</p>
                </div>

                <div class="feature-card reveal" style="--stagger-index:1">
                    <div class="feature-icon-large">💳</div>
                    <h4>Online Payments</h4>
                    <p>Integrated Stripe payment processing for secure, instant transactions. No cash handling needed — everything is digital.</p>
                </div>

                <div class="feature-card reveal" style="--stagger-index:2">
                    <div class="feature-icon-large">👤</div>
                    <h4>User Accounts</h4>
                    <p>Customers create accounts to save addresses, track orders, and manage their purchase history. Secure authentication with sessions.</p>
                </div>

                <div class="feature-card reveal" style="--stagger-index:3">
                    <div class="feature-icon-large">🛒</div>
                    <h4>Product Catalog</h4>
                    <p>Over 200 products with categories, images, pricing, and inventory management. Easy to browse and search.</p>
                </div>

                <div class="feature-card reveal" style="--stagger-index:4">
                    <div class="feature-icon-large">📦</div>
                    <h4>Order Management</h4>
                    <p>Real-time order tracking with status updates. Customers can see their order history and current order status.</p>
                </div>

                <div class="feature-card reveal" style="--stagger-index:5">
                    <div class="feature-icon-large">🔐</div>
                    <h4>Secure Authentication</h4>
                    <p>Password hashing with bcrypt, session management, and role-based access control for admin and regular users.</p>
                </div>

                <div class="feature-card reveal" style="--stagger-index:6">
                    <div class="feature-icon-large">📊</div>
                    <h4>Admin Dashboard</h4>
                    <p>Full admin interface to monitor orders, manage products, view customer data, and track sales analytics.</p>
                </div>

                <div class="feature-card reveal" style="--stagger-index:7">
                    <div class="feature-icon-large">📱</div>
                    <h4>Mobile Responsive</h4>
                    <p>Built with Bootstrap for a seamless experience on desktop, tablet, and mobile devices.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== TECH STACK ===== -->
    <section class="zema-tech section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">tech-stack</span>
                <h2>Technologies <span class="grad-text">Used</span></h2>
            </div>

            <div class="tech-stack-grid">
                <div class="tech-stack-item reveal" style="--stagger-index:0">
                    <span class="tech-stack-icon">🟢</span>
                    <span class="tech-stack-name">Node.js</span>
                    <span class="tech-stack-desc">JavaScript runtime</span>
                </div>
                <div class="tech-stack-item reveal" style="--stagger-index:1">
                    <span class="tech-stack-icon">🚀</span>
                    <span class="tech-stack-name">Express.js</span>
                    <span class="tech-stack-desc">Web framework</span>
                </div>
                <div class="tech-stack-item reveal" style="--stagger-index:2">
                    <span class="tech-stack-icon">🐬</span>
                    <span class="tech-stack-name">MySQL</span>
                    <span class="tech-stack-desc">Database</span>
                </div>
                <div class="tech-stack-item reveal" style="--stagger-index:3">
                    <span class="tech-stack-icon">📄</span>
                    <span class="tech-stack-name">HTML5</span>
                    <span class="tech-stack-desc">Structure</span>
                </div>
                <div class="tech-stack-item reveal" style="--stagger-index:4">
                    <span class="tech-stack-icon">🎨</span>
                    <span class="tech-stack-name">CSS3</span>
                    <span class="tech-stack-desc">Styling</span>
                </div>
                <div class="tech-stack-item reveal" style="--stagger-index:5">
                    <span class="tech-stack-icon">📜</span>
                    <span class="tech-stack-name">JavaScript</span>
                    <span class="tech-stack-desc">Frontend logic</span>
                </div>
                <div class="tech-stack-item reveal" style="--stagger-index:6">
                    <span class="tech-stack-icon">💳</span>
                    <span class="tech-stack-name">Stripe</span>
                    <span class="tech-stack-desc">Payments</span>
                </div>
                <div class="tech-stack-item reveal" style="--stagger-index:7">
                    <span class="tech-stack-icon">📱</span>
                    <span class="tech-stack-name">Bootstrap</span>
                    <span class="tech-stack-desc">UI framework</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== STATUS ===== -->
    <section class="zema-status section-tight">
        <div class="container">
            <div class="status-banner reveal">
                <div class="status-banner-content">
                    <span class="status-banner-icon">⚠️</span>
                    <div>
                        <h3>Currently Paused</h3>
                        <p>The supermarket has paused operations recently. The platform is fully functional and ready to be reactivated at any time.</p>
                    </div>
                </div>
                <div class="status-badge">
                    <span class="status-dot"></span>
                    <span>Status: Paused</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== GALLERY / IMAGES ===== -->
    <section class="zema-gallery section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">screenshots</span>
                <h2>Platform <span class="grad-text">Preview</span></h2>
            </div>

            <div class="gallery-grid">
                <div class="gallery-placeholder reveal" style="--stagger-index:0">
                    <div class="placeholder-icon">🛒</div>
                    <span>Product Catalog</span>
                </div>
                <div class="gallery-placeholder reveal" style="--stagger-index:1">
                    <div class="placeholder-icon">💳</div>
                    <span>Checkout & Payments</span>
                </div>
                <div class="gallery-placeholder reveal" style="--stagger-index:2">
                    <div class="placeholder-icon">📍</div>
                    <span>Location Verification</span>
                </div>
                <div class="gallery-placeholder reveal" style="--stagger-index:3">
                    <div class="placeholder-icon">📊</div>
                    <span>Admin Dashboard</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="section-tight">
        <div class="container">
            <div class="reveal cta-banner">
                <span class="eyebrow" style="justify-content: center;">need-something-similar</span>
                <h2 style="font-size: 2rem;">Need an e-commerce<br><span class="grad-text">platform for your business?</span></h2>
                <p style="max-width: 500px; margin: 0 auto var(--space-5);">Let's build a custom online store that works for you.</p>
                <a href="/contact" class="btn btn-primary">Start Your Project</a>
            </div>
        </div>
    </section>

</div>

<style>
    /* ===== ZEMA HERO ===== */
    .zema-hero {
        padding-top: var(--space-4);
    }

    .zema-hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: var(--space-8);
        align-items: center;
        min-height: 50vh;
    }

    .zema-hero-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .zema-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        background: rgba(0, 229, 255, 0.08);
        border: 1px solid rgba(0, 229, 255, 0.15);
        border-radius: 999px;
        padding: 6px 16px 6px 10px;
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--accent-cyan);
        width: fit-content;
        font-family: var(--font-mono);
    }

    .zema-headline {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: clamp(2.4rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .zema-line-gradient {
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .zema-description {
        font-size: 1.1rem;
        max-width: 480px;
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0;
    }

    .zema-stats {
        display: flex;
        align-items: center;
        gap: var(--space-6);
        padding-top: var(--space-4);
        border-top: 1px solid var(--border-subtle);
        margin-top: var(--space-2);
    }

    .zema-stat {
        display: flex;
        flex-direction: column;
    }

    .zema-stat-number {
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.01em;
    }

    .zema-stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        font-weight: 400;
    }

    .zema-stat-divider {
        width: 1px;
        height: 32px;
        background: var(--border-subtle);
    }

    /* ===== ZEMA VISUAL ===== */
    .zema-hero-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
    }

    .zema-orb {
        position: absolute;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle at center, rgba(0, 229, 255, 0.06), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: floatY 8s ease-in-out infinite;
    }

    .zema-icon-display {
        position: relative;
        z-index: 1;
    }

    .zema-icon-circle {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: var(--bg-surface);
        border: 2px solid var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.4s var(--ease-out-expo);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    }

        .zema-icon-circle:hover {
            transform: scale(1.05);
            border-color: var(--border-glow);
        }

    .zema-icon-large {
        font-size: 4rem;
    }

    .zema-icon-ring {
        position: absolute;
        inset: -60px;
        pointer-events: none;
    }

    .zema-ring-icon {
        position: absolute;
        font-size: 1.8rem;
        animation: floatY 4s ease-in-out infinite;
    }

        .zema-ring-icon:nth-child(1) {
            animation-delay: 0s;
        }

        .zema-ring-icon:nth-child(2) {
            animation-delay: 0.5s;
        }

        .zema-ring-icon:nth-child(3) {
            animation-delay: 1s;
        }

        .zema-ring-icon:nth-child(4) {
            animation-delay: 1.5s;
        }

    /* ===== OVERVIEW ===== */
    .zema-overview {
        padding: var(--space-8) 0;
        background: rgba(0, 0, 0, 0.15);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
    }

    .overview-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-5);
        margin-top: var(--space-6);
    }

    .overview-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        text-align: center;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    }

        .overview-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
        }

    .overview-icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: var(--space-2);
    }

    .overview-card h4 {
        font-size: 1rem;
        margin: 0 0 var(--space-2);
        font-family: var(--font-display);
        font-weight: 600;
    }

    .overview-card p {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.6;
    }

    .tech-tag-group {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        justify-content: center;
        margin-top: var(--space-2);
    }

    .tech-tag {
        font-size: 0.65rem;
        font-family: var(--font-mono);
        padding: 2px 10px;
        border-radius: 999px;
        border: 1px solid var(--border-subtle);
        color: var(--text-muted);
    }

    .metrics-list {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
    }

        .metrics-list li {
            font-size: 0.85rem;
            color: var(--text-secondary);
            padding: var(--space-1) 0;
            display: flex;
            align-items: center;
            gap: var(--space-2);
        }

    /* ===== FEATURES ===== */
    .zema-features {
        padding: var(--space-8) 0;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
        margin-top: var(--space-6);
    }

    .feature-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-4);
        text-align: center;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    }

        .feature-card:hover {
            transform: translateY(-4px);
            border-color: var(--border-glow);
        }

    .feature-icon-large {
        font-size: 2rem;
        display: block;
        margin-bottom: var(--space-2);
    }

    .feature-card h4 {
        font-size: 0.95rem;
        margin: 0 0 var(--space-1);
        font-family: var(--font-display);
        font-weight: 600;
    }

    .feature-card p {
        font-size: 0.82rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.5;
    }

    /* ===== TECH STACK ===== */
    .zema-tech {
        padding: var(--space-8) 0;
        background: rgba(0, 0, 0, 0.15);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
    }

    .tech-stack-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
        margin-top: var(--space-6);
    }

    .tech-stack-item {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: var(--space-4);
        text-align: center;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    }

        .tech-stack-item:hover {
            transform: translateY(-4px);
            border-color: var(--accent-cyan);
        }

    .tech-stack-icon {
        font-size: 1.8rem;
        display: block;
        margin-bottom: var(--space-1);
    }

    .tech-stack-name {
        display: block;
        font-weight: 600;
        color: var(--text-primary);
        font-size: 0.9rem;
    }

    .tech-stack-desc {
        font-size: 0.7rem;
        color: var(--text-muted);
    }

    /* ===== STATUS BANNER ===== */
    .zema-status {
        padding: var(--space-6) 0;
    }

    .status-banner {
        background: var(--bg-surface);
        border: 1px solid var(--warning);
        border-radius: var(--radius-lg);
        padding: var(--space-5) var(--space-6);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-4);
    }

    .status-banner-content {
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }

    .status-banner-icon {
        font-size: 2.5rem;
    }

    .status-banner-content h3 {
        font-size: 1.1rem;
        margin: 0;
        color: var(--warning);
        font-family: var(--font-display);
        font-weight: 600;
    }

    .status-banner-content p {
        margin: 0;
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .status-badge {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: 6px 16px;
        border-radius: 999px;
        background: rgba(255, 176, 32, 0.1);
        border: 1px solid rgba(255, 176, 32, 0.2);
        font-size: 0.78rem;
        font-family: var(--font-mono);
        color: var(--warning);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--warning);
        animation: pulseGlow 2s ease-in-out infinite;
    }

    /* ===== GALLERY ===== */
    .zema-gallery {
        padding: var(--space-8) 0;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
        margin-top: var(--space-6);
    }

    .gallery-placeholder {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 150px;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
        cursor: default;
    }

        .gallery-placeholder:hover {
            transform: translateY(-4px);
            border-color: var(--border-glow);
        }

    .placeholder-icon {
        font-size: 3rem;
        margin-bottom: var(--space-2);
    }

    .gallery-placeholder span {
        font-size: 0.85rem;
        color: var(--text-secondary);
        font-family: var(--font-mono);
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .zema-hero-grid {
            grid-template-columns: 1fr;
            min-height: auto;
            gap: var(--space-6);
        }

        .zema-hero-content {
            order: 1;
        }

        .zema-hero-visual {
            order: 0;
        }

        .zema-headline {
            font-size: clamp(2rem, 4vw, 2.8rem);
        }

        .zema-description {
            font-size: 1rem;
            max-width: 100%;
        }

        .overview-grid {
            grid-template-columns: 1fr 1fr;
        }

        .features-grid {
            grid-template-columns: 1fr 1fr;
        }

        .tech-stack-grid {
            grid-template-columns: 1fr 1fr;
        }

        .gallery-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .zema-stats {
            flex-wrap: wrap;
            gap: var(--space-4);
