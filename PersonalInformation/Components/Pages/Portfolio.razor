@page "/portfolio"

<div class="page-enter">

    <!-- ===== HERO SECTION ===== -->
    <section class="portfolio-hero section">
        <div class="container">
            <div class="portfolio-hero-grid">
                <div class="portfolio-hero-content">
                    <div class="hero-badge reveal" style="--stagger-index:0">
                        <span class="badge-dot"></span>
                        <span>Portfolio</span>
                    </div>
                    <h1 class="portfolio-headline reveal" style="--stagger-index:1">
                        <span class="portfolio-line">Selected</span>
                        <span class="portfolio-line portfolio-line-gradient">work.</span>
                    </h1>
                    <p class="portfolio-description reveal" style="--stagger-index:2">
                        A look at some of the projects I've built — from full-stack platforms to
                        business systems and internal tools.
                    </p>
                    <div class="portfolio-stats reveal" style="--stagger-index:3">
                        <div class="portfolio-stat">
                            <span class="portfolio-stat-number">12</span>
                            <span class="portfolio-stat-label">Projects</span>
                        </div>
                        <div class="portfolio-stat-divider"></div>
                        <div class="portfolio-stat">
                            <span class="portfolio-stat-number">100%</span>
                            <span class="portfolio-stat-label">Test Coverage</span>
                        </div>
                        <div class="portfolio-stat-divider"></div>
                        <div class="portfolio-stat">
                            <span class="portfolio-stat-number">5+</span>
                            <span class="portfolio-stat-label">Years Building</span>
                        </div>
                    </div>
                </div>
                <div class="portfolio-hero-visual reveal" style="--stagger-index:2">
                    <div class="portfolio-orb"></div>
                    <div class="portfolio-icon-grid">
                        <div class="portfolio-icon-card floaty" style="animation-delay: 0s;">
                            <span class="portfolio-icon">🌐</span>
                        </div>
                        <div class="portfolio-icon-card floaty" style="animation-delay: 0.8s;">
                            <span class="portfolio-icon">📱</span>
                        </div>
                        <div class="portfolio-icon-card floaty" style="animation-delay: 1.6s;">
                            <span class="portfolio-icon">🖥️</span>
                        </div>
                        <div class="portfolio-icon-card floaty" style="animation-delay: 0.4s;">
                            <span class="portfolio-icon">⚡</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== PROJECTS ===== -->
    <section class="projects-section section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">projects</span>
                <h2>Things I've<br><span class="grad-text">built and shipped.</span></h2>
            </div>

            <div class="projects-grid">
                <!-- Project 1: PetWell -->
                <div class="project-card reveal" style="--stagger-index:0">
                    <div class="project-card-top">
                        <div class="project-card-badge">
                            <span class="badge-icon">🚀</span>
                            <span class="badge-text">Featured</span>
                        </div>
                        <div class="project-card-icon">🐾</div>
                    </div>
                    <h3>PetWell</h3>
                    <span class="project-category">Full-Stack Platform</span>
                    <p>A pet care management platform with real-time notifications, secure auth, and media management. Built with Node.js, Express, MySQL, and Bootstrap.</p>
                    <div class="project-tags">
                        <span class="project-tag">Node.js</span>
                        <span class="project-tag">Express</span>
                        <span class="project-tag">MySQL</span>
                        <span class="project-tag">Jest</span>
                        <span class="project-tag">OWASP</span>
                    </div>
                    <div class="project-links">
                        <a href="https://www.youtube.com/watch?v=9MmI1D5OK8U" class="project-link" target="_blank">
                            <span>Live Demo</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                        </a>
                        <a href="https://github.com/ali-abdulsameea-abubaker/pet-care-management-app" class="project-link" target="_blank">
                            <span>GitHub</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                        </a>
                    </div>
                    <div class="project-card-stats">
                        <div class="project-stat-item">
                            <span class="stat-value">100%</span>
                            <span class="stat-label">Test Coverage</span>
                        </div>
                        <div class="project-stat-divider"></div>
                        <div class="project-stat-item">
                            <span class="stat-value">2025</span>
                            <span class="stat-label">Completed</span>
                        </div>
                    </div>
                </div>

                <!-- Project 2: Internal Business Tools - DETAILED -->
                <div class="project-card reveal project-card-expanded" style="--stagger-index:1">
                    <div class="project-card-top">
                        <div class="project-card-badge">
                            <span class="badge-icon">🔧</span>
                            <span class="badge-text">Internal</span>
                        </div>
                        <div class="project-card-icon">🏢</div>
                    </div>
                    <h3>Internal Business Tools</h3>
                    <span class="project-category">.NET / ASP.NET</span>
                    <p>Custom business management systems built for security companies and supermarkets using .NET Framework and C#.</p>


                    <div class="project-tags">
                        <span class="project-tag">C#</span>
                        <span class="project-tag">.NET Framework</span>
                        <span class="project-tag">ASP.NET</span>
                        <span class="project-tag">SQL Server</span>
                        <span class="project-tag">WinForms</span>
                        <span class="project-tag">CRUD</span>
                    </div>
                    <div class="project-links">
                        <a href="/portfolio/internal-tools" class="project-link">
                            <span>Learn More</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                        </a>
                    </div>
                    <div class="project-card-stats">
                        <div class="project-stat-item">
                            <span class="stat-value">300+</span>
                            <span class="stat-label">Users Supported</span>
                        </div>
                        <div class="project-stat-divider"></div>
                        <div class="project-stat-item">
                            <span class="stat-value">4+</span>
                            <span class="stat-label">Systems Built</span>
                        </div>
                        <div class="project-stat-divider"></div>
                        <div class="project-stat-item">
                            <span class="stat-value">2024</span>
                            <span class="stat-label">In Production</span>
                        </div>
                    </div>
                </div>

                <!-- Project 3: Business Websites -->
                <div class="project-card reveal" style="--stagger-index:2">
                    <div class="project-card-top">
                        <div class="project-card-badge">
                            <span class="badge-icon">✨</span>
                            <span class="badge-text">Client Work</span>
                        </div>
                        <div class="project-card-icon">💼</div>
                    </div>
                    <h3>Business Website & Systems</h3>
                    <span class="project-category">Web + Systems</span>
                    <p>Custom websites and lightweight management systems delivered for small business clients — from landing pages to inventory tracking.</p>
                    <div class="project-tags">
                        <span class="project-tag">React</span>
                        <span class="project-tag">TypeScript</span>
                        <span class="project-tag">Node.js</span>
                        <span class="project-tag">Bootstrap</span>
                    </div>
                    <div class="project-links">
                        <a href="/portfolio/zema-supermarket" class="project-link">
                            <span>View Projects</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                        </a>
                    </div>
                    <div class="project-card-stats">
                        <div class="project-stat-item">
                            <span class="stat-value">8+</span>
                            <span class="stat-label">Clients Served</span>
                        </div>
                        <div class="project-stat-divider"></div>
                        <div class="project-stat-item">
                            <span class="stat-value">2023-24</span>
                            <span class="stat-label">Projects</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== SKILLS SHOWCASE ===== -->
    <section class="skills-showcase section-tight">
        <div class="container">
            <div class="skills-showcase-grid">
                <div class="skills-showcase-content reveal" style="--stagger-index:0">
                    <span class="eyebrow">tech-stack</span>
                    <h2>Tools I use to<br><span class="grad-text">build great software.</span></h2>
                    <p>Every project is built with modern, reliable technologies that scale with your business.</p>
                </div>
                <div class="skills-showcase-icons reveal" style="--stagger-index:1">
                    <div class="tech-icon">.NET</div>
                    <div class="tech-icon">C#</div>
                    <div class="tech-icon">Node.js</div>
                    <div class="tech-icon">React</div>
                    <div class="tech-icon">TypeScript</div>
                    <div class="tech-icon">Azure</div>
                    <div class="tech-icon">SQL</div>
                    <div class="tech-icon">MongoDB</div>
                    <div class="tech-icon">Git</div>
                    <div class="tech-icon">Docker</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== TESTIMONIAL / CTA ===== -->
    <section class="section-tight">
        <div class="container">
            <div class="reveal cta-banner">
                <span class="eyebrow" style="justify-content: center;">ready-to-build</span>
                <h2 style="font-size: 2rem;">Want something like this<br>for <span class="grad-text">your business?</span></h2>
                <p style="max-width: 500px; margin: 0 auto var(--space-5);">Let's talk about your project and build something great together.</p>
                <a href="/contact" class="btn btn-primary">Start a Project</a>
            </div>
        </div>
    </section>

</div>