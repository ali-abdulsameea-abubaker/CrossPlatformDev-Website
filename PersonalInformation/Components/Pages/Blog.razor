@page "/blog"
@inject PersonalInformation.Services.BlogService BlogService
@inject IJSRuntime JS
@inject IConfiguration Config
@using System.Net.Http
@using System.Text
@using System.Text.Json

<div class="page-enter">

    <!-- ===== HERO SECTION ===== -->
    <section class="blog-hero section">
        <div class="container">
            <div class="blog-hero-grid">
                <div class="blog-hero-content">
                    <div class="hero-badge reveal" style="--stagger-index:0">
                        <span class="badge-dot"></span>
                        <span>Blog</span>
                    </div>
                    <h1 class="blog-headline reveal" style="--stagger-index:1">
                        <span class="blog-line">Notes from</span>
                        <span class="blog-line blog-line-gradient">the build.</span>
                    </h1>
                    <p class="blog-description reveal" style="--stagger-index:2">
                        Writing about web development, mobile apps, and what actually matters when building
                        business software that works.
                    </p>
                    <div class="blog-stats reveal" style="--stagger-index:3">
                        <div class="blog-stat">
                            <span class="blog-stat-number">@allPosts.Count</span>
                            <span class="blog-stat-label">Posts Published</span>
                        </div>
                        <div class="blog-stat-divider"></div>
                        <div class="blog-stat">
                            <span class="blog-stat-number">@allPosts.Count</span>
                            <span class="blog-stat-label">Topics Covered</span>
                        </div>
                        <div class="blog-stat-divider"></div>
                        <div class="blog-stat">
                            <span class="blog-stat-number">✍️</span>
                            <span class="blog-stat-label">Writing</span>
                        </div>
                    </div>
                </div>
                <div class="blog-hero-visual reveal" style="--stagger-index:2">
                    <div class="blog-orb"></div>
                    <div class="blog-writing-icon">
                        <div class="writing-pulse"></div>
                        <span class="writing-emoji">✍️</span>
                        <div class="writing-rings">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== ALL POSTS ===== -->
    <section class="blog-posts-section section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">all-posts</span>
                <h2>Recent <span class="grad-text">articles.</span></h2>
            </div>

            @if (allPosts.Count == 0)
            {
                <div class="no-posts reveal text-center">
                    <span style="font-size: 3rem; display: block; margin-bottom: var(--space-4);">📝</span>
                    <h3>No posts yet</h3>
                    <p style="color: var(--text-muted);">Check back soon for new articles.</p>
                </div>
            }
            else
            {
                <div class="posts-grid">
                    @foreach (var post in allPosts)
                    {
                        <a href="/blog/@post.Slug" class="post-card reveal" style="--stagger-index:@allPosts.IndexOf(post)">
                            <div class="post-card-tag">@post.Tag</div>
                            <h3>@post.Title</h3>
                            <p>@post.Excerpt</p>
                            <div class="post-card-meta">
                                <span>@post.Date.ToString("MMMM d, yyyy")</span>
                                <span class="post-card-divider"></span>
                                <span>@post.ReadTime</span>
                            </div>
                            <div class="post-card-arrow">→</div>
                        </a>
                    }
                </div>
            }
        </div>
    </section>

    <!-- ===== NEWSLETTER SIGNUP ===== -->
    <section class="newsletter-section section-tight">
        <div class="container">
            <div class="reveal newsletter-card">
                <div class="newsletter-content">
                    <div class="newsletter-icon">📬</div>
                    <h2>Get notified when I post.</h2>
                    <p>No spam, just good content. I'll send you an email when new articles are published.</p>

                    @if (newsletterSubscribed)
                    {
                        <div style="padding: var(--space-4);">
                            <span style="font-size: 3rem; display: block; margin-bottom: var(--space-2);">✅</span>
                            <h3 style="margin-bottom: var(--space-2);">Subscribed!</h3>
                            <p style="color: var(--text-secondary);">You'll receive an email when new posts are published.</p>
                            <button class="btn btn-ghost" @onclick="ResetSubscription" style="margin-top: var(--space-3);">
                                Subscribe another email
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="newsletter-form">
                            <input type="email" placeholder="Enter your email" class="input newsletter-input"
                                   @bind="newsletterEmail" @bind:event="oninput" />
                            <button class="btn btn-primary newsletter-btn" @onclick="SubscribeNewsletter" disabled="@newsletterLoading">
                                @if (newsletterLoading)
                                {
                                    <span>Sending...</span>
                                }
                                else
                                {
                                    <span>Subscribe</span>
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                                }
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(newsletterMessage))
                        {
                            <p style="color: @(newsletterMessage.Contains("✅") ? "var(--success)" : "var(--warning)"); margin-top: var(--space-3); font-size: 0.9rem;">
                                @newsletterMessage
                            </p>
                        }
                        <span class="newsletter-note">No spam. Unsubscribe anytime.</span>
                    }
                </div>
            </div>
        </div>
    </section>

</div>

<style>
    /* ===== BLOG HERO ===== */
    .blog-hero {
        padding-top: var(--space-4);
    }

    .blog-hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: var(--space-8);
        align-items: center;
        min-height: 50vh;
    }

    .blog-hero-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .blog-headline {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: clamp(2.4rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .blog-line-gradient {
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .blog-description {
        font-size: 1.1rem;
        max-width: 480px;
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0;
    }

    .blog-stats {
        display: flex;
        align-items: center;
        gap: var(--space-6);
        padding-top: var(--space-4);
        border-top: 1px solid var(--border-subtle);
        margin-top: var(--space-2);
    }

    .blog-stat {
        display: flex;
        flex-direction: column;
    }

    .blog-stat-number {
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.01em;
    }

    .blog-stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        font-weight: 400;
    }

    .blog-stat-divider {
        width: 1px;
        height: 32px;
        background: var(--border-subtle);
    }

    /* ===== HERO VISUAL ===== */
    .blog-hero-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
    }

    .blog-orb {
        position: absolute;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle at center, rgba(0, 229, 255, 0.06), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: floatY 8s ease-in-out infinite;
    }

    .blog-writing-icon {
        position: relative;
        z-index: 1;
        width: 120px;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-surface);
        border-radius: 50%;
        border: 2px solid var(--border-subtle);
        animation: floatY 6s ease-in-out infinite;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    }

        .blog-writing-icon:hover {
            transform: scale(1.05);
            border-color: var(--border-glow);
        }

    .writing-emoji {
        font-size: 3.5rem;
        animation: pulseGlow 3s ease-in-out infinite;
    }

    .writing-pulse {
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        border: 2px solid rgba(0, 229, 255, 0.15);
        animation: pulseRing 2.5s ease-in-out infinite;
    }

    .writing-rings {
        position: absolute;
        inset: -20px;
        pointer-events: none;
    }

        .writing-rings span {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 1px solid rgba(0, 229, 255, 0.05);
            animation: ringExpand 4s ease-in-out infinite;
        }

            .writing-rings span:nth-child(2) {
                animation-delay: 1.3s;
            }

            .writing-rings span:nth-child(3) {
                animation-delay: 2.6s;
            }

    @@keyframes pulseRing {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.1);
            opacity: 0.3;
        }
    }

    @@keyframes ringExpand {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.3);
            opacity: 0;
        }
    }

    /* ===== POSTS GRID ===== */
    .blog-posts-section {
        padding: var(--space-8) 0;
    }

    .posts-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-5);
        margin-top: var(--space-6);
    }

    .post-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        text-decoration: none;
        color: inherit;
        transition: transform 0.4s var(--ease-out-expo), border-color 0.4s, box-shadow 0.4s;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }

        .post-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--accent-gradient);
            opacity: 0;
            transition: opacity 0.4s;
        }

        .post-card:hover::before {
            opacity: 1;
        }

        .post-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

    .post-card-tag {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--accent-cyan);
        background: rgba(0, 229, 255, 0.06);
        border: 1px solid rgba(0, 229, 255, 0.08);
        padding: 2px 10px;
        border-radius: 999px;
        width: fit-content;
    }

    .post-card h3 {
        font-size: 1.1rem;
        margin: 0;
        font-family: var(--font-display);
        font-weight: 600;
        line-height: 1.3;
        color: var(--text-primary);
    }

    .post-card p {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin: 0;
        line-height: 1.6;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .post-card-meta {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: 0.75rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        margin-top: var(--space-1);
    }

    .post-card-divider {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: var(--text-muted);
    }

    .post-card-arrow {
        font-size: 1.2rem;
        color: var(--accent-cyan);
        transition: transform 0.3s var(--ease-out-expo);
        align-self: flex-end;
        margin-top: var(--space-1);
    }

    .post-card:hover .post-card-arrow {
        transform: translateX(4px);
    }

    /* ===== NO POSTS ===== */
    .no-posts {
        padding: var(--space-8) 0;
    }

        .no-posts h3 {
            font-size: 1.4rem;
            margin-bottom: var(--space-2);
        }

    /* ===== NEWSLETTER ===== */
    .newsletter-section {
        padding: var(--space-8) 0;
        background: rgba(0, 0, 0, 0.2);
        border-top: 1px solid var(--border-subtle);
    }

    .newsletter-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-glow);
        border-radius: var(--radius-lg);
        padding: var(--space-8) var(--space-6);
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
    }

        .newsletter-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(60% 100% at 50% 0%, rgba(0, 229, 255, 0.04), transparent 70%);
            pointer-events: none;
        }

    .newsletter-content {
        position: relative;
        z-index: 1;
    }

    .newsletter-icon {
        font-size: 3rem;
        margin-bottom: var(--space-3);
        animation: floatY 4s ease-in-out infinite;
    }

    .newsletter-content h2 {
        font-size: 1.8rem;
        margin-bottom: var(--space-2);
    }

    .newsletter-content p {
        max-width: 400px;
        margin: 0 auto var(--space-5);
        color: var(--text-secondary);
    }

    .newsletter-form {
        display: flex;
        gap: var(--space-3);
        max-width: 500px;
        margin: 0 auto;
        align-items: center;
    }

    .newsletter-input {
        flex: 1;
        padding: 14px 18px;
        background: var(--bg-elevated);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 0.95rem;
        transition: border-color 0.3s;
        min-width: 200px;
    }

        .newsletter-input:focus {
            outline: none;
            border-color: var(--accent-cyan);
        }

        .newsletter-input::placeholder {
            color: var(--text-muted);
        }

    .newsletter-btn {
        padding: 14px 28px;
        font-size: 0.95rem;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .newsletter-btn svg {
            transition: transform 0.3s var(--ease-out-expo);
        }

        .newsletter-btn:hover svg {
            transform: translateX(4px);
        }

        .newsletter-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .newsletter-note {
        display: block;
        font-size: 0.7rem;
        color: var(--text-muted);
        margin-top: var(--space-3);
        font-family: var(--font-mono);
    }

    /* ===== SECTION HEADER ===== */
    .section-header {
        margin-bottom: var(--space-6);
    }

        .section-header.text-center {
            text-align: center;
        }

            .section-header.text-center h2 {
                max-width: 600px;
                margin: 0 auto;
            }

            .section-header.text-center p {
                max-width: 500px;
                margin: var(--space-3) auto 0;
            }

    .text-center {
        text-align: center;
    }

    /* ===== BUTTONS ===== */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-family: var(--font-body);
        font-weight: 600;
        font-size: 0.95rem;
        padding: 13px 26px;
        border-radius: var(--radius-md);
        border: 1px solid transparent;
        cursor: pointer;
        transition: transform var(--dur-fast) var(--ease-out-expo), box-shadow var(--dur-fast), background var(--dur-fast);
    }

    .btn-primary {
        background: var(--accent-gradient);
        background-size: 200% 200%;
        color: #04121a;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 229, 255, 0.28);
            animation: gradientShift 3s ease infinite;
        }

    .btn-ghost {
        background: transparent;
        border-color: var(--border-subtle);
        color: var(--text-primary);
    }

        .btn-ghost:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
            transform: translateY(-2px);
        }

    .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.82rem;
        color: var(--accent-cyan);
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-3);
        letter-spacing: 0.02em;
    }

        .eyebrow::before {
            content: "~/";
            color: var(--text-muted);
        }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--space-3);
        background: rgba(0, 229, 255, 0.08);
        border: 1px solid rgba(0, 229, 255, 0.15);
        border-radius: 999px;
        padding: 6px 16px 6px 10px;
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--accent-cyan);
        width: fit-content;
        font-family: var(--font-mono);
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--success);
        animation: pulseGlow 2s ease-in-out infinite;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .blog-hero-grid {
            grid-template-columns: 1fr;
            min-height: auto;
            gap: var(--space-6);
        }

        .blog-hero-content {
            order: 1;
        }

        .blog-hero-visual {
            order: 0;
        }

        .blog-headline {
            font-size: clamp(2rem, 4vw, 2.8rem);
        }

        .blog-description {
            font-size: 1rem;
            max-width: 100%;
        }

        .posts-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .blog-stats {
            flex-wrap: wrap;
            gap: var(--space-4);
        }

        .blog-stat-divider {
            display: none;
        }

        .posts-grid {
            grid-template-columns: 1fr;
        }

        .newsletter-form {
            flex-direction: column;
        }

        .newsletter-btn {
            width: 100%;
            justify-content: center;
        }

        .newsletter-input {
            width: 100%;
            min-width: unset;
        }

        .blog-writing-icon {
            width: 90px;
            height: 90px;
        }

        .writing-emoji {
            font-size: 2.5rem;
        }
    }

    @@media (max-width: 480px) {
        .blog-stats {
            flex-direction: column;
            align-items: flex-start;
        }

        .post-card {
            padding: var(--space-4);
        }
    }

    /* ===== SUBSCRIBE BUTTON - WHITE TEXT ===== */
    .newsletter-btn {
        color: #ffffff !important;
    }

        .newsletter-btn span {
            color: #ffffff !important;
        }

        .newsletter-btn svg {
            stroke: #ffffff !important;
        }

        .newsletter-btn:disabled {
            color: #ffffff !important;
            opacity: 0.7;
        }

            .newsletter-btn:disabled span {
                color: #ffffff !important;
            }
</style>

@code {
    private List<PersonalInformation.Models.BlogPost> allPosts = new();
    private string newsletterEmail = "";
    private bool newsletterLoading = false;
    private string? newsletterMessage;
    private bool newsletterSubscribed = false;

    protected override void OnInitialized()
    {
        allPosts = BlogService.GetAllPosts();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("siteAnimations.initAll");
    }

    private async Task SubscribeNewsletter()
    {
        if (string.IsNullOrWhiteSpace(newsletterEmail) || !IsValidEmail(newsletterEmail))
        {
            newsletterMessage = "⚠️ Please enter a valid email address.";
            return;
        }

        newsletterLoading = true;
        newsletterMessage = null;
        StateHasChanged();

        try
        {
            var apiKey = Config["Resend:ApiKey"];

            if (string.IsNullOrEmpty(apiKey))
            {
                newsletterMessage = "⚠️ Newsletter service is not configured. Please try again later.";
                newsletterLoading = false;
                StateHasChanged();
                return;
            }

            using var client = new HttpClient();
            client.DefaultRequestHeaders.Add("Authorization", $"Bearer {apiKey}");

            var payload = new
            {
                from = "onboarding@resend.dev",
                to = new[] { newsletterEmail },
                subject = "Welcome to CrossPlatformDev Blog!",
                html = $@"
                    <h2>📬 Welcome to the CrossPlatformDev Blog!</h2>
                    <p>Thanks for subscribing, <strong>{newsletterEmail}</strong>!</p>
                    <p>You'll receive a notification whenever I publish a new article about web development, mobile apps, and business systems.</p>
                    <p style='font-size: 0.9rem; color: #666;'>
                        — Ali Abubaker, CrossPlatformDev
                    </p>
                    <hr />
                    <p style='font-size: 0.8rem; color: #999;'>
                        You can unsubscribe at any time by replying to this email.
                    </p>
                "
            };

            var content = new StringContent(
                JsonSerializer.Serialize(payload),
                Encoding.UTF8,
                "application/json"
            );

            var response = await client.PostAsync("https://api.resend.com/emails", content);

            if (response.IsSuccessStatusCode)
            {
                newsletterSubscribed = true;
                newsletterMessage = "✅ Subscribed successfully! Check your email for confirmation.";
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                newsletterMessage = "⚠️ Something went wrong. Please try again later.";
                Console.WriteLine($"Resend error: {error}");
            }
        }
        catch (Exception ex)
        {
            newsletterMessage = "⚠️ Something went wrong. Please try again later.";
            Console.WriteLine($"Newsletter error: {ex.Message}");
        }
        finally
        {
            newsletterLoading = false;
            StateHasChanged();
        }
    }

    private void ResetSubscription()
    {
        newsletterSubscribed = false;
        newsletterEmail = "";
        newsletterMessage = null;
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }
}