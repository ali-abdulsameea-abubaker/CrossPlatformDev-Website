@page "/services"

<SeoHead Title="Services — Website, Mobile App & System Development | CrossPlatformDev"
         Description="Website creation, Android and mobile application development, and custom business management system development, including supermarket and inventory systems."
         Path="/services" />

<div class="page-enter section">
    <div class="container">
        <AnimatedSection>
            <SectionEyebrow Text="services" />
            <h1>What I build.</h1>
            <p>Every project starts with your actual business problem, not a template.</p>
        </AnimatedSection>

        <div class="service-list">
            <AnimatedSection Variant="reveal-left" StaggerIndex="0">
                <div class="service-row">
                    <h2>01 — Website Creation</h2>
                    <p>
                        Business websites, portfolios, and e-commerce storefronts. Fast-loading, mobile-responsive,
                        and built so you can find your business easily on Google.
                    </p>
                </div>
            </AnimatedSection>
            <AnimatedSection Variant="reveal-left" StaggerIndex="1">
                <div class="service-row">
                    <h2>02 — Mobile & Android Applications</h2>
                    <p>
                        Cross-platform and native Android apps, from first wireframe to a published app on the
                        Play Store.
                    </p>
                </div>
            </AnimatedSection>
            <AnimatedSection Variant="reveal-left" StaggerIndex="2">
                <div class="service-row">
                    <h2>03 — Management Systems</h2>
                    <p>
                        Custom systems for supermarkets, retail, and service businesses — inventory tracking,
                        point-of-sale, staff scheduling, and reporting dashboards.
                    </p>
                </div>
            </AnimatedSection>
            <AnimatedSection Variant="reveal-left" StaggerIndex="3">
                <div class="service-row">
                    <h2>04 — Ongoing Support</h2>
                    <p>
                        Bug fixes, feature additions, and IT support after launch — I stay involved after the
                        first deploy.
                    </p>
                </div>
            </AnimatedSection>
        </div>

        <AnimatedSection><CtaBanner Heading="Not sure which service fits?" Subheading="Tell me about your business and I'll recommend the right build." /></AnimatedSection>
    </div>
</div>