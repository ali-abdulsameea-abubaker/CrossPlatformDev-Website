@page "/services"

<div class="page-enter">

    <!-- ===== HERO SECTION ===== -->
    <section class="services-hero section">
        <div class="container">
            <div class="services-hero-grid">
                <div class="services-hero-content">
                    <div class="hero-badge reveal" style="--stagger-index:0">
                        <span class="badge-dot"></span>
                        <span>What I build</span>
                    </div>
                    <h1 class="services-headline reveal" style="--stagger-index:1">
                        <span class="services-line">Services that</span>
                        <span class="services-line services-line-gradient">solve real problems.</span>
                    </h1>
                    <p class="services-description reveal" style="--stagger-index:2">
                        Every project starts with your actual business problem, not a template.
                        I build custom software that works for your specific needs.
                    </p>
                    <div class="services-stat-strip reveal" style="--stagger-index:3">
                        <div class="stat-item">
                            <span class="stat-number">50+</span>
                            <span class="stat-label">Projects Delivered</span>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item">
                            <span class="stat-number">100%</span>
                            <span class="stat-label">Client Satisfaction</span>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item">
                            <span class="stat-number">24h</span>
                            <span class="stat-label">Response Time</span>
                        </div>
                    </div>
                </div>
                <div class="services-hero-visual reveal" style="--stagger-index:2">
                    <div class="services-orb"></div>
                    <div class="services-icon-grid">
                        <div class="service-icon-card floaty" style="animation-delay: 0s;">
                            <span class="service-icon">🌐</span>
                            <span class="service-icon-label">Web</span>
                        </div>
                        <div class="service-icon-card floaty" style="animation-delay: 0.8s;">
                            <span class="service-icon">📱</span>
                            <span class="service-icon-label">Mobile</span>
                        </div>
                        <div class="service-icon-card floaty" style="animation-delay: 1.6s;">
                            <span class="service-icon">🖥️</span>
                            <span class="service-icon-label">Systems</span>
                        </div>
                        <div class="service-icon-card floaty" style="animation-delay: 0.4s;">
                            <span class="service-icon">⚡</span>
                            <span class="service-icon-label">Support</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== SERVICES LIST ===== -->
    <section class="services-list-section section-tight">
        <div class="container">
            <div class="section-header reveal">
                <span class="eyebrow">what-i-build</span>
                <h2>Everything you need,<br><span class="grad-text">built by one developer.</span></h2>
            </div>

            <div class="services-grid">
                <!-- Service 1 -->
                <div class="service-card reveal" style="--stagger-index:0">
                    <div class="service-card-number">01</div>
                    <div class="service-card-icon">🌐</div>
                    <h3>Website Creation</h3>
                    <p>Business websites, portfolios, and e-commerce storefronts. Fast-loading, mobile-responsive, and built so you can find your business easily on Google.</p>
                    <div class="service-card-tags">
                        <span class="pill">Business Websites</span>
                        <span class="pill">E-commerce</span>
                        <span class="pill">SEO Optimized</span>
                    </div>
                    <a href="/contact" class="service-card-link">
                        <span>Get a website</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                    </a>
                </div>

                <!-- Service 2 -->
                <div class="service-card reveal" style="--stagger-index:1">
                    <div class="service-card-number">02</div>
                    <div class="service-card-icon">📱</div>
                    <h3>Mobile & Android Apps</h3>
                    <p>Cross-platform and native Android apps, from first wireframe to a published app on the Play Store. Built for performance and user experience.</p>
                    <div class="service-card-tags">
                        <span class="pill">Android</span>
                        <span class="pill">iOS</span>
                        <span class="pill">Cross-Platform</span>
                    </div>
                    <a href="/contact" class="service-card-link">
                        <span>Build an app</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                    </a>
                </div>

                <!-- Service 3 -->
                <div class="service-card reveal" style="--stagger-index:2">
                    <div class="service-card-number">03</div>
                    <div class="service-card-icon">🖥️</div>
                    <h3>Management Systems</h3>
                    <p>Custom systems for supermarkets, retail, and service businesses — inventory tracking, point-of-sale, staff scheduling, and reporting dashboards.</p>
                    <div class="service-card-tags">
                        <span class="pill">Inventory</span>
                        <span class="pill">POS</span>
                        <span class="pill">Dashboards</span>
                    </div>
                    <a href="/contact" class="service-card-link">
                        <span>Build a system</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                    </a>
                </div>

                <!-- Service 4 -->
                <div class="service-card reveal" style="--stagger-index:3">
                    <div class="service-card-number">04</div>
                    <div class="service-card-icon">⚡</div>
                    <h3>Ongoing Support</h3>
                    <p>Bug fixes, feature additions, and IT support after launch — I stay involved after the first deploy. Your software keeps improving.</p>
                    <div class="service-card-tags">
                        <span class="pill">Maintenance</span>
                        <span class="pill">Feature Updates</span>
                        <span class="pill">IT Support</span>
                    </div>
                    <a href="/contact" class="service-card-link">
                        <span>Get support</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== PROCESS SECTION ===== -->
    <section class="process-section section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">how-it-works</span>
                <h2>From idea to launch<br><span class="grad-text">in 4 simple steps.</span></h2>
            </div>

            <div class="process-grid">
                <div class="process-step reveal" style="--stagger-index:0">
                    <div class="process-step-number">01</div>
                    <div class="process-step-content">
                        <h4>Discovery Call</h4>
                        <p>We talk about your business, your problem, and what you need built.</p>
                    </div>
                </div>
                <div class="process-connector"></div>
                <div class="process-step reveal" style="--stagger-index:1">
                    <div class="process-step-number">02</div>
                    <div class="process-step-content">
                        <h4>Plan & Design</h4>
                        <p>I map out the architecture, design the interface, and plan the development.</p>
                    </div>
                </div>
                <div class="process-connector"></div>
                <div class="process-step reveal" style="--stagger-index:2">
                    <div class="process-step-number">03</div>
                    <div class="process-step-content">
                        <h4>Build & Test</h4>
                        <p>I code, test, and iterate until everything works perfectly.</p>
                    </div>
                </div>
                <div class="process-connector"></div>
                <div class="process-step reveal" style="--stagger-index:3">
                    <div class="process-step-number">04</div>
                    <div class="process-step-content">
                        <h4>Launch & Support</h4>
                        <p>Deploy, train your team, and stay available for updates and fixes.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="section-tight">
        <div class="container">
            <div class="reveal cta-banner">
                <span class="eyebrow" style="justify-content: center;">ready-to-build</span>
                <h2 style="font-size: 2rem;">Not sure which service fits?</h2>
                <p style="max-width: 500px; margin: 0 auto var(--space-5);">Tell me about your business and I'll recommend the right build.</p>
                <a href="/contact" class="btn btn-primary">Tell me about your business</a>
            </div>
        </div>
    </section>

</div>

<style>
    /* ===== SERVICES HERO ===== */
    .services-hero {
        padding-top: var(--space-6);
    }

    .services-hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: var(--space-8);
        align-items: center;
        min-height: 50vh;
    }

    .services-hero-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .services-headline {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: clamp(2.4rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .services-line-gradient {
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .services-description {
        font-size: 1.1rem;
        max-width: 480px;
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0;
    }

    .services-stat-strip {
        display: flex;
        align-items: center;
        gap: var(--space-6);
        padding-top: var(--space-4);
        border-top: 1px solid var(--border-subtle);
        margin-top: var(--space-2);
    }

    .stat-item {
        display: flex;
        flex-direction: column;
    }

    .stat-number {
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.01em;
    }

    .stat-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        font-weight: 400;
    }

    .stat-divider {
        width: 1px;
        height: 32px;
        background: var(--border-subtle);
    }

    /* ===== SERVICES VISUAL ===== */
    .services-hero-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
    }

    .services-orb {
        position: absolute;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle at center, rgba(0, 229, 255, 0.06), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: floatY 8s ease-in-out infinite;
    }

    .services-icon-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-5);
        position: relative;
        z-index: 1;
    }

    .service-icon-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        width: 120px;
        height: 120px;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        transition: transform 0.4s var(--ease-out-expo), border-color 0.4s, box-shadow 0.4s;
        cursor: default;
    }

        .service-icon-card:hover {
            transform: translateY(-8px) scale(1.03);
            border-color: var(--border-glow);
            box-shadow: 0 20px 60px rgba(0, 229, 255, 0.06);
        }

    .service-icon {
        font-size: 2.4rem;
        line-height: 1;
    }

    .service-icon-label {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--text-muted);
        letter-spacing: 0.04em;
    }

    /* ===== SERVICES GRID ===== */
    .services-list-section {
        padding: var(--space-8) 0;
    }

    .services-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-5);
        margin-top: var(--space-6);
    }

    .service-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        transition: transform 0.4s var(--ease-out-expo), border-color 0.4s, box-shadow 0.4s;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

        .service-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--accent-gradient);
            opacity: 0;
            transition: opacity 0.4s;
        }

        .service-card:hover::before {
            opacity: 1;
        }

        .service-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

    .service-card-number {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--text-muted);
        letter-spacing: 0.04em;
        opacity: 0.5;
    }

    .service-card-icon {
        font-size: 2rem;
        line-height: 1;
        margin-bottom: var(--space-1);
    }

    .service-card h3 {
        font-size: 1.3rem;
        margin: 0;
        font-family: var(--font-display);
        font-weight: 600;
    }

    .service-card p {
        color: var(--text-secondary);
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.6;
        flex: 1;
    }

    .service-card-tags {
        display: flex;
        gap: var(--space-2);
        flex-wrap: wrap;
        margin: var(--space-2) 0;
    }

    .service-card-link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--accent-cyan);
        font-weight: 600;
        font-size: 0.9rem;
        transition: gap 0.3s var(--ease-out-expo);
        margin-top: var(--space-1);
    }

        .service-card-link:hover {
            gap: var(--space-4);
        }

        .service-card-link svg {
            transition: transform 0.3s var(--ease-out-expo);
        }

        .service-card-link:hover svg {
            transform: translateX(4px);
        }

    /* ===== PROCESS SECTION ===== */
    .process-section {
        padding: var(--space-8) 0;
        background: rgba(0, 0, 0, 0.2);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
    }

    .process-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
        align-items: start;
        gap: var(--space-4);
        margin-top: var(--space-6);
        position: relative;
    }

    .process-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: var(--space-3);
        padding: var(--space-4);
    }

    .process-step-number {
        font-family: var(--font-mono);
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--accent-cyan);
        opacity: 0.3;
        line-height: 1;
    }

    .process-step-content h4 {
        font-size: 1rem;
        margin: 0 0 var(--space-1);
        font-family: var(--font-display);
        font-weight: 600;
    }

    .process-step-content p {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin: 0;
        max-width: 180px;
    }

    .process-connector {
        width: 30px;
        height: 2px;
        background: var(--border-subtle);
        margin-top: 48px;
        position: relative;
    }

        .process-connector::after {
            content: "→";
            position: absolute;
            right: -8px;
            top: -8px;
            color: var(--text-muted);
            font-size: 0.8rem;
        }

    /* ===== SECTION HEADER ===== */
    .section-header {
        margin-bottom: var(--space-6);
    }

        .section-header.text-center {
            text-align: center;
        }

            .section-header.text-center h2 {
                max-width: 600px;
                margin: 0 auto;
            }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .services-hero-grid {
            grid-template-columns: 1fr;
            min-height: auto;
            gap: var(--space-6);
        }

        .services-hero-content {
            order: 1;
        }

        .services-hero-visual {
            order: 0;
        }

        .services-headline {
            font-size: clamp(2rem, 4vw, 2.8rem);
        }

        .services-description {
            font-size: 1rem;
            max-width: 100%;
        }

        .services-stat-strip {
            flex-wrap: wrap;
            gap: var(--space-4);
        }

        .stat-divider {
            display: none;
        }

        .services-icon-grid {
            gap: var(--space-3);
        }

        .service-icon-card {
            width: 100px;
            height: 100px;
        }

        .process-grid {
            grid-template-columns: 1fr;
            gap: var(--space-6);
        }

        .process-connector {
            display: none;
        }

        .process-step-content p {
            max-width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .services-grid {
            grid-template-columns: 1fr;
        }

        .service-icon-card {
            width: 80px;
            height: 80px;
        }

        .service-icon {
            font-size: 1.8rem;
        }

        .services-orb {
            width: 250px;
            height: 250px;
        }
    }

    @@media (max-width: 480px) {
        .services-stat-strip {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-2);
        }

        .services-icon-grid {
            grid-template-columns: 1fr 1fr;
            gap: var(--space-2);
        }

        .service-icon-card {
            width: 70px;
            height: 70px;
        }

        .service-icon {
            font-size: 1.4rem;
        }

        .service-icon-label {
            font-size: 0.6rem;
        }
    }
</style>