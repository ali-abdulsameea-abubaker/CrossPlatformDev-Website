@page "/about"

<SeoHead Title="About Ali Abubaker — CrossPlatformDev"
         Description="Software developer with 5+ years of experience in full-stack development, IT infrastructure, and cybersecurity."
         Path="/about" />

<div class="page-enter section">
    <div class="container about-grid">
        <AnimatedSection Variant="reveal-left">
            <SectionEyebrow Text="about" />
            <h1>Hi, I'm Ali.</h1>
            <p>
                Senior software developer with 5+ years of experience in full-stack development, IT infrastructure,
                and operations. I've built and maintained production .NET and Node.js applications, with a strong
                foundation in cybersecurity and cloud architecture.
            </p>
            <p>
                Currently a .NET Software Developer at Gerrie Electric, and previously an IT Help Desk Technician
                resolving 300+ support requests. I hold an Advanced Diploma in Software Development from Mohawk
                College and a Microsoft Azure certification.
            </p>
            <a href="/contact" class="btn btn-primary">Get in Touch</a>
        </AnimatedSection>

        <AnimatedSection Variant="reveal-right">
            <div class="card">
                <h3>Core Stack</h3>
                <div class="tag-row">
                    <span class="pill">C# / .NET</span>
                    <span class="pill">ASP.NET Core</span>
                    <span class="pill">JavaScript / TypeScript</span>
                    <span class="pill">Node.js / Express</span>
                    <span class="pill">SQL Server / MySQL</span>
                    <span class="pill">Azure DevOps</span>
                </div>
            </div>
        </AnimatedSection>
    </div>
</div>