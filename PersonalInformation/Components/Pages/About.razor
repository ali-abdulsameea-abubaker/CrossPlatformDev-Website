</div>

<style>
    /* ===== ABOUT HERO ===== */
    .about-hero {
        padding-top: var(--space-4);
    }

    .about-hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: var(--space-8);
        align-items: center;
        min-height: 50vh;
    }

    .about-hero-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .about-headline {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: clamp(2.4rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .about-line-gradient {
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .about-description {
        font-size: 1.1rem;
        max-width: 500px;
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0;
    }

    .about-actions {
        display: flex;
        gap: var(--space-4);
        flex-wrap: wrap;
        margin-top: var(--space-2);
    }

    /* ===== AVATAR ===== */
    .about-hero-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
    }

    .about-orb {
        position: absolute;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle at center, rgba(0, 229, 255, 0.06), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: floatY 8s ease-in-out infinite;
    }

    .about-avatar {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-4);
    }

    .avatar-ring {
        width: 160px;
        height: 160px;
        border-radius: 50%;
        padding: 4px;
        background: var(--accent-gradient);
        animation: spin 10s linear infinite;
        box-shadow: 0 0 60px rgba(0, 229, 255, 0.1);
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .avatar-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: var(--bg-void);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .avatar-emoji {
        font-size: 4rem;
        animation: floatY 4s ease-in-out infinite;
    }

    .avatar-status {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(10px);
        padding: 8px 16px;
        border-radius: 999px;
        border: 1px solid var(--border-subtle);
        font-size: 0.82rem;
        color: var(--text-secondary);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--success);
        animation: pulseGlow 2s ease-in-out infinite;
    }

    .status-text {
        color: var(--text-primary);
    }

    /* ===== BIO ===== */
    .bio-section {
        padding: var(--space-8) 0;
    }

    .bio-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: var(--space-8);
        align-items: start;
    }

    .bio-content h2 {
        font-size: clamp(2rem, 3vw, 2.6rem);
        margin-bottom: var(--space-4);
    }

    .bio-content p {
        font-size: 1rem;
        line-height: 1.7;
    }

    .bio-content strong {
        color: var(--text-primary);
    }

    .bio-highlights {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        margin-top: var(--space-4);
        padding-top: var(--space-4);
        border-top: 1px solid var(--border-subtle);
    }

    .highlight-item {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: 0.9rem;
        color: var(--text-secondary);
    }

    .highlight-icon {
        font-size: 1.2rem;
    }

    /* ===== STATS ===== */
    .bio-stats {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4);
        width: 100%;
    }

    .stat-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: var(--space-4);
        text-align: center;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-4px);
            border-color: var(--border-glow);
        }

    .stat-number {
        display: block;
        font-family: var(--font-display);
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--accent-cyan);
        line-height: 1.2;
    }

    .stat-label {
        display: block;
        font-size: 0.78rem;
        color: var(--text-muted);
        margin-top: var(--space-1);
    }

    .stat-bar {
        width: 100%;
        height: 3px;
        background: var(--border-subtle);
        border-radius: 999px;
        margin-top: var(--space-2);
        overflow: hidden;
    }

    .stat-bar-fill {
        height: 100%;
        background: var(--accent-gradient);
        border-radius: 999px;
        transition: width 1.5s var(--ease-out-expo);
    }

    /* ===== SKILLS ===== */
    .skills-section {
        padding: var(--space-8) 0;
        background: rgba(0, 0, 0, 0.2);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
    }

    .skills-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-5);
        margin-top: var(--space-6);
    }

    .skill-category {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    }

        .skill-category:hover {
            transform: translateY(-4px);
            border-color: var(--border-glow);
        }

    .skill-category-header {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-4);
        padding-bottom: var(--space-3);
        border-bottom: 1px solid var(--border-subtle);
    }

    .skill-category-icon {
        font-size: 1.4rem;
    }

    .skill-category-header h4 {
        font-size: 1rem;
        margin: 0;
        font-family: var(--font-display);
        font-weight: 600;
    }

    .skill-items {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .skill-item {
        display: grid;
        grid-template-columns: 1fr 2fr 40px;
        align-items: center;
        gap: var(--space-3);
    }

    .skill-name {
        font-size: 0.85rem;
        color: var(--text-secondary);
    }

    .skill-bar {
        height: 4px;
        background: var(--border-subtle);
        border-radius: 999px;
        overflow: hidden;
    }

    .skill-bar-fill {
        height: 100%;
        background: var(--accent-gradient);
        border-radius: 999px;
        transition: width 1.5s var(--ease-out-expo);
    }

    .skill-percent {
