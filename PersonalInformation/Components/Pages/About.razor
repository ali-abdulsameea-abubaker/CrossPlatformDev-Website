@page "/about"

<div class="page-enter">

    <!-- ===== HERO SECTION ===== -->
    <section class="about-hero section">
        <div class="container">
            <div class="about-hero-grid">
                <div class="about-hero-content">
                    <div class="hero-badge reveal" style="--stagger-index:0">
                        <span class="badge-dot"></span>
                        <span>About me</span>
                    </div>
                    <h1 class="about-headline reveal" style="--stagger-index:1">
                        <span class="about-line">Hi, I'm Ali.</span>
                        <span class="about-line about-line-gradient">I build software that works.</span>
                    </h1>
                    <p class="about-description reveal" style="--stagger-index:2">
                        Senior software developer with 5+ years of experience in full-stack development, IT infrastructure,
                        and operations. I've built and maintained production .NET and Node.js applications, with a strong
                        foundation in cybersecurity and cloud architecture.
                    </p>
                    <div class="about-actions reveal" style="--stagger-index:3">
                        <a href="/contact" class="btn btn-primary btn-large">
                            <span>Get in Touch</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
                        </a>
                        <a href="/portfolio" class="btn btn-ghost btn-large">View My Work</a>
                    </div>
                </div>
                <div class="about-hero-visual reveal" style="--stagger-index:2">
                    <div class="about-orb"></div>
                    <div class="about-avatar">
                        <div class="avatar-ring">
                            <div class="avatar-inner">
                                <span class="avatar-emoji">👨‍💻</span>
                            </div>
                        </div>
                        <div class="avatar-status">
                            <span class="status-dot"></span>
                            <span class="status-text">Available for projects</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== BIO + STATS ===== -->
    <section class="bio-section section-tight">
        <div class="container">
            <div class="bio-grid">
                <div class="bio-content reveal" style="--stagger-index:0">
                    <span class="eyebrow">who-i-am</span>
                    <h2>From Hamilton,<br><span class="grad-text">building global solutions.</span></h2>
                    <p>
                        Currently a <strong>.NET Software Developer</strong> at Gerrie Electric in Burlington, ON,
                        and previously an IT Help Desk Technician resolving 300+ support requests. I hold an
                        <strong>Advanced Diploma in Software Development</strong> from Mohawk College and a
                        <strong>Microsoft Azure certification</strong>.
                    </p>
                    <p>
                        I'm passionate about leveraging technology to solve real-world problems. My experience
                        spans full-stack development, cloud architecture, and IT operations — all with a focus
                        on building software that actually ships.
                    </p>
                    <div class="bio-highlights">
                        <div class="highlight-item">
                            <span class="highlight-icon">📍</span>
                            <span>Hamilton, ON, Canada</span>
                        </div>
                        <div class="highlight-item">
                            <span class="highlight-icon">🌍</span>
                            <span>Available worldwide</span>
                        </div>
                        <div class="highlight-item">
                            <span class="highlight-icon">🗣️</span>
                            <span>English, Kurdish, Arabic</span>
                        </div>
                    </div>
                </div>
                <div class="bio-stats reveal" style="--stagger-index:1">
                    <div class="stats-grid">
                        <div class="stat-card">
                            <span class="stat-number" data-count="5">0</span>
                            <span class="stat-label">Years Experience</span>
                            <div class="stat-bar"><div class="stat-bar-fill" style="width: 100%;"></div></div>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" data-count="300">0</span>
                            <span class="stat-label">Support Cases Resolved</span>
                            <div class="stat-bar"><div class="stat-bar-fill" style="width: 100%;"></div></div>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" data-count="100">0</span>
                            <span class="stat-label">% Test Coverage</span>
                            <div class="stat-bar"><div class="stat-bar-fill" style="width: 100%;"></div></div>
                        </div>
                        <div class="stat-card">
