@page "/services/ongoing-support"
@page "/services#support"

<div class="page-enter">
    <!-- Hero Section -->
    <section class="service-hero section">
        <div class="container">
            <div class="service-hero-grid">
                <div class="service-hero-content reveal" style="--stagger-index:0">
                    <span class="eyebrow">service</span>
                    <h1 class="service-headline">
                        <span class="service-line">Ongoing</span>
                        <span class="service-line service-line-gradient">Support</span>
                    </h1>
                    <p class="service-description">
                        Bug fixes, feature additions, and IT support after launch. I stay involved after the first deploy
                        to ensure your software keeps running smoothly and grows with your business.
                    </p>
                    <div class="service-actions">
                        <a href="/contact" class="btn btn-primary">Get Support</a>
                        <a href="/portfolio" class="btn btn-ghost">See Examples</a>
                    </div>
                </div>
                <div class="service-hero-visual reveal" style="--stagger-index:1">
                    <div class="service-orb"></div>
                    <div class="service-icon-display">
                        <div class="service-icon-circle floaty">
                            <span class="service-icon-large">⚡</span>
                        </div>
                        <div class="service-icon-ring">
                            <span class="ring-icon" style="top: -10%; left: 50%;">🔧</span>
                            <span class="ring-icon" style="bottom: -10%; left: 30%;">🚀</span>
                            <span class="ring-icon" style="bottom: -10%; right: 30%;">🛠️</span>
                            <span class="ring-icon" style="top: -10%; right: 10%;">📞</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Overview -->
    <section class="section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">overview</span>
                <h2>What I <span class="grad-text">Offer</span></h2>
            </div>

            <div class="overview-grid">
                <div class="overview-card reveal" style="--stagger-index:0">
                    <div class="overview-icon">🐛</div>
                    <h4>Bug Fixes</h4>
                    <p>Fast resolution of issues and bugs to keep your software running smoothly.</p>
                </div>
                <div class="overview-card reveal" style="--stagger-index:1">
                    <div class="overview-icon">✨</div>
                    <h4>Feature Additions</h4>
                    <p>Add new features and functionality as your business grows and needs change.</p>
                </div>
                <div class="overview-card reveal" style="--stagger-index:2">
                    <div class="overview-icon">🔒</div>
                    <h4>Security Updates</h4>
                    <p>Keep your software secure with regular security patches and updates.</p>
                </div>
                <div class="overview-card reveal" style="--stagger-index:3">
                    <div class="overview-icon">📞</div>
                    <h4>IT Support</h4>
                    <p>Technical support and troubleshooting for your team and users.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Support Plans -->
    <section class="section-tight tech-section">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">plans</span>
                <h2>Support <span class="grad-text">Plans</span></h2>
            </div>

            <div class="pricing-grid">
                <div class="pricing-card reveal" style="--stagger-index:0">
                    <div class="pricing-icon">🔧</div>
                    <h4>Basic Support</h4>
                    <div class="pricing-price">$500 / month</div>
                    <ul class="pricing-features">
                        <li>✓ 5 support tickets/month</li>
                        <li>✓ Bug fixes only</li>
                        <li>✓ 48-hour response time</li>
                        <li>✓ Email support</li>
                    </ul>
                </div>
                <div class="pricing-card featured reveal" style="--stagger-index:1">
                    <div class="pricing-badge">Most Popular</div>
                    <div class="pricing-icon">⚡</div>
                    <h4>Standard Support</h4>
                    <div class="pricing-price">$1,000 / month</div>
                    <ul class="pricing-features">
                        <li>✓ 15 support tickets/month</li>
                        <li>✓ Bug fixes + features</li>
                        <li>✓ 24-hour response time</li>
                        <li>✓ Email + phone support</li>
                        <li>✓ Monthly check-ins</li>
                    </ul>
                </div>
                <div class="pricing-card reveal" style="--stagger-index:2">
                    <div class="pricing-icon">🚀</div>
                    <h4>Premium Support</h4>
                    <div class="pricing-price">$2,000+ / month</div>
                    <ul class="pricing-features">
                        <li>✓ Unlimited tickets</li>
                        <li>✓ Priority fixes</li>
                        <li>✓ 12-hour response time</li>
                        <li>✓ Dedicated support</li>
                        <li>✓ Weekly check-ins</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Benefits -->
    <section class="section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">benefits</span>
                <h2>Why <span class="grad-text">Support Matters</span></h2>
            </div>

            <div class="benefits-grid">
                <div class="benefit-card reveal" style="--stagger-index:0">
                    <span class="benefit-icon">🛡️</span>
                    <h4>Peace of Mind</h4>
                    <p>Know that someone is always available to fix issues and keep your software running.</p>
                </div>
                <div class="benefit-card reveal" style="--stagger-index:1">
                    <span class="benefit-icon">📈</span>
                    <h4>Business Continuity</h4>
                    <p>Minimize downtime and keep your business operations flowing smoothly.</p>
                </div>
                <div class="benefit-card reveal" style="--stagger-index:2">
                    <span class="benefit-icon">🚀</span>
                    <h4>Growth Ready</h4>
                    <p>Add features and scale your software as your business grows.</p>
                </div>
                <div class="benefit-card reveal" style="--stagger-index:3">
                    <span class="benefit-icon">💪</span>
                    <h4>Expert Help</h4>
                    <p>Get help from someone who knows your system inside and out.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="section-tight">
        <div class="container">
            <div class="reveal cta-banner">
                <span class="eyebrow" style="justify-content: center;">ready-to-start</span>
                <h2 style="font-size: 2rem;">Need <span class="grad-text">ongoing support?</span></h2>
                <p style="max-width: 500px; margin: 0 auto var(--space-5);">Let's keep your software running smoothly.</p>
                <a href="/contact" class="btn btn-primary">Get Support Now</a>
            </div>
        </div>
    </section>
</div>

<style>
    .service-hero {
        padding-top: var(--space-4);
    }

    .service-hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: var(--space-8);
        align-items: center;
        min-height: 50vh;
    }

    .service-hero-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .service-headline {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: clamp(2.4rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .service-line-gradient {
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .service-description {
        font-size: 1.1rem;
        max-width: 480px;
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0;
    }

    .service-actions {
        display: flex;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .service-hero-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
    }

    .service-orb {
        position: absolute;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle at center, rgba(0, 229, 255, 0.06), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: floatY 8s ease-in-out infinite;
    }

    .service-icon-display {
        position: relative;
        z-index: 1;
    }

    .service-icon-circle {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: var(--bg-surface);
        border: 2px solid var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.4s var(--ease-out-expo);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    }

        .service-icon-circle:hover {
            transform: scale(1.05);
            border-color: var(--border-glow);
        }

    .service-icon-large {
        font-size: 4rem;
    }

    .service-icon-ring {
        position: absolute;
        inset: -60px;
        pointer-events: none;
    }

    .ring-icon {
        position: absolute;
        font-size: 1.8rem;
        animation: floatY 4s ease-in-out infinite;
    }

        .ring-icon:nth-child(1) {
            animation-delay: 0s;
        }

        .ring-icon:nth-child(2) {
            animation-delay: 0.5s;
        }

        .ring-icon:nth-child(3) {
            animation-delay: 1s;
        }

        .ring-icon:nth-child(4) {
            animation-delay: 1.5s;
        }

    .overview-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
        margin-top: var(--space-6);
    }

    .overview-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        text-align: center;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    }

        .overview-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
        }

    .overview-icon {
        font-size: 2.5rem;
        margin-bottom: var(--space-2);
    }

    .overview-card h4 {
        font-size: 1rem;
        margin: 0 0 var(--space-1);
    }

    .overview-card p {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin: 0;
    }

    .tech-section {
        background: rgba(0, 0, 0, 0.2);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
    }

    .pricing-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-5);
        margin-top: var(--space-6);
    }

    .pricing-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        text-align: center;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
        position: relative;
    }

        .pricing-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
        }

        .pricing-card.featured {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 40px rgba(0, 229, 255, 0.05);
        }

    .pricing-badge {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--accent-gradient);
        color: #04121a;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 16px;
        border-radius: 999px;
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .pricing-icon {
        font-size: 2.5rem;
    }

    .pricing-card h4 {
        font-size: 1.2rem;
        margin: var(--space-2) 0 var(--space-1);
    }

    .pricing-price {
        font-family: var(--font-display);
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--accent-cyan);
        margin-bottom: var(--space-4);
    }

    .pricing-features {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
    }

        .pricing-features li {
            padding: var(--space-1) 0;
            color: var(--text-secondary);
            font-size: 0.9rem;
            border-bottom: 1px solid var(--border-subtle);
        }

            .pricing-features li:last-child {
                border-bottom: none;
            }

    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
        margin-top: var(--space-6);
    }

    .benefit-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        text-align: center;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    }

        .benefit-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
        }

    .benefit-icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: var(--space-2);
    }

    .benefit-card h4 {
        font-size: 1rem;
        margin: 0 0 var(--space-1);
    }

    .benefit-card p {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin: 0;
    }

    @@media (max-width: 1024px) {
        .service-hero-grid {
            grid-template-columns: 1fr;
            min-height: auto;
            gap: var(--space-6);
        }

        .service-hero-content {
            order: 1;
        }

        .service-hero-visual {
            order: 0;
        }

        .service-headline {
            font-size: clamp(2rem, 4vw, 2.8rem);
        }

        .service-description {
            font-size: 1rem;
            max-width: 100%;
        }

        .overview-grid {
            grid-template-columns: 1fr 1fr;
        }

        .benefits-grid {
            grid-template-columns: 1fr 1fr;
        }

        .pricing-grid {
            grid-template-columns: 1fr;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }
    }

    @@media (max-width: 600px) {
        .overview-grid {
            grid-template-columns: 1fr;
        }

        .benefits-grid {
            grid-template-columns: 1fr;
        }

        .service-actions {
            flex-direction: column;
            width: 100%;
        }

            .service-actions .btn {
                width: 100%;
                justify-content: center;
            }

        .service-icon-circle {
            width: 120px;
            height: 120px;
        }

        .service-icon-large {
            font-size: 3rem;
        }

        .service-icon-ring {
            display: none;
        }

        .pricing-price {
            font-size: 1.4rem;
        }
    }
</style>