@page "/services/business-systems"
@page "/services#systems"

<div class="page-enter">
    <!-- Hero Section -->
    <section class="service-hero section">
        <div class="container">
            <div class="service-hero-grid">
                <div class="service-hero-content reveal" style="--stagger-index:0">
                    <span class="eyebrow">service</span>
                    <h1 class="service-headline">
                        <span class="service-line">Business</span>
                        <span class="service-line service-line-gradient">Management Systems</span>
                    </h1>
                    <p class="service-description">
                        Custom software solutions for supermarkets, retail stores, and service businesses.
                        Inventory tracking, POS systems, staff scheduling, and reporting dashboards that streamline operations.
                    </p>
                    <div class="service-actions">
                        <a href="/contact" class="btn btn-primary">Build Your System</a>
                        <a href="/portfolio" class="btn btn-ghost">See Examples</a>
                    </div>
                </div>
                <div class="service-hero-visual reveal" style="--stagger-index:1">
                    <div class="service-orb"></div>
                    <div class="service-icon-display">
                        <div class="service-icon-circle floaty">
                            <span class="service-icon-large">🖥️</span>
                        </div>
                        <div class="service-icon-ring">
                            <span class="ring-icon" style="top: -10%; left: 50%;">📊</span>
                            <span class="ring-icon" style="bottom: -10%; left: 30%;">🛒</span>
                            <span class="ring-icon" style="bottom: -10%; right: 30%;">📈</span>
                            <span class="ring-icon" style="top: -10%; right: 10%;">👥</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Overview -->
    <section class="section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">overview</span>
                <h2>What I <span class="grad-text">Build</span></h2>
            </div>

            <div class="overview-grid">
                <div class="overview-card reveal" style="--stagger-index:0">
                    <div class="overview-icon">🛒</div>
                    <h4>POS Systems</h4>
                    <p>Complete point-of-sale systems with inventory management, sales tracking, and reporting.</p>
                </div>
                <div class="overview-card reveal" style="--stagger-index:1">
                    <div class="overview-icon">📦</div>
                    <h4>Inventory Management</h4>
                    <p>Track stock levels, manage suppliers, and automate reordering processes.</p>
                </div>
                <div class="overview-card reveal" style="--stagger-index:2">
                    <div class="overview-icon">📋</div>
                    <h4>Staff Scheduling</h4>
                    <p>Employee scheduling, shift management, and time tracking systems.</p>
                </div>
                <div class="overview-card reveal" style="--stagger-index:3">
                    <div class="overview-icon">📊</div>
                    <h4>Reporting Dashboards</h4>
                    <p>Real-time dashboards with sales analytics, performance metrics, and business insights.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Tech Stack -->
    <section class="section-tight tech-section">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">tech-stack</span>
                <h2>What I <span class="grad-text">Use</span></h2>
            </div>

            <div class="tech-grid">
                <div class="tech-item reveal" style="--stagger-index:0">
                    <span class="tech-icon-large">⚡</span>
                    <span class="tech-name">.NET Core</span>
                    <span class="tech-desc">Backend & APIs</span>
                </div>
                <div class="tech-item reveal" style="--stagger-index:1">
                    <span class="tech-icon-large">📘</span>
                    <span class="tech-name">C#</span>
                    <span class="tech-desc">Core programming</span>
                </div>
                <div class="tech-item reveal" style="--stagger-index:2">
                    <span class="tech-icon-large">🗄️</span>
                    <span class="tech-name">SQL Server</span>
                    <span class="tech-desc">Database</span>
                </div>
                <div class="tech-item reveal" style="--stagger-index:3">
                    <span class="tech-icon-large">🔧</span>
                    <span class="tech-name">React</span>
                    <span class="tech-desc">Dashboard UI</span>
                </div>
                <div class="tech-item reveal" style="--stagger-index:4">
                    <span class="tech-icon-large">☁️</span>
                    <span class="tech-name">Azure</span>
                    <span class="tech-desc">Cloud hosting</span>
                </div>
                <div class="tech-item reveal" style="--stagger-index:5">
                    <span class="tech-icon-large">🔒</span>
                    <span class="tech-name">OWASP</span>
                    <span class="tech-desc">Security</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing -->
    <section class="section-tight">
        <div class="container">
            <div class="section-header reveal text-center">
                <span class="eyebrow" style="justify-content: center;">pricing</span>
                <h2>Investment <span class="grad-text">Guide</span></h2>
            </div>

            <div class="pricing-grid">
                <div class="pricing-card reveal" style="--stagger-index:0">
                    <div class="pricing-icon">📋</div>
                    <h4>Basic System</h4>
                    <div class="pricing-price">$5,000 - $8,000</div>
                    <ul class="pricing-features">
                        <li>✓ Inventory management</li>
                        <li>✓ Basic reporting</li>
                        <li>✓ 1 user role</li>
                        <li>✓ 4-6 weeks delivery</li>
                    </ul>
                </div>
                <div class="pricing-card featured reveal" style="--stagger-index:1">
                    <div class="pricing-badge">Most Popular</div>
                    <div class="pricing-icon">🛒</div>
                    <h4>Full POS System</h4>
                    <div class="pricing-price">$8,000 - $15,000</div>
                    <ul class="pricing-features">
                        <li>✓ POS with sales tracking</li>
                        <li>✓ Full inventory</li>
                        <li>✓ Staff management</li>
                        <li>✓ Reporting dashboard</li>
                        <li>✓ 6-10 weeks delivery</li>
                    </ul>
                </div>
                <div class="pricing-card reveal" style="--stagger-index:2">
                    <div class="pricing-icon">📊</div>
                    <h4>Enterprise System</h4>
                    <div class="pricing-price">$15,000+</div>
                    <ul class="pricing-features">
                        <li>✓ Full custom system</li>
                        <li>✓ Advanced analytics</li>
                        <li>✓ Multi-location</li>
                        <li>✓ Integration ready</li>
                        <li>✓ 10+ weeks delivery</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="section-tight">
        <div class="container">
            <div class="reveal cta-banner">
                <span class="eyebrow" style="justify-content: center;">ready-to-start</span>
                <h2 style="font-size: 2rem;">Ready to <span class="grad-text">build your system?</span></h2>
                <p style="max-width: 500px; margin: 0 auto var(--space-5);">Let's create software that runs your business.</p>
                <a href="/contact" class="btn btn-primary">Get a Free Quote</a>
            </div>
        </div>
    </section>
</div>

<!-- Reuse same styles -->
<style>
    .service-hero {
        padding-top: var(--space-4);
    }

    .service-hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: var(--space-8);
        align-items: center;
        min-height: 50vh;
    }

    .service-hero-content {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .service-headline {
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: clamp(2.4rem, 5vw, 4rem);
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .service-line-gradient {
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .service-description {
        font-size: 1.1rem;
        max-width: 480px;
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0;
    }

    .service-actions {
        display: flex;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .service-hero-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
    }

    .service-orb {
        position: absolute;
        width: 350px;
        height: 350px;
        background: radial-gradient(circle at center, rgba(0, 229, 255, 0.06), transparent 70%);
        border-radius: 50%;
        pointer-events: none;
        animation: floatY 8s ease-in-out infinite;
    }

    .service-icon-display {
        position: relative;
        z-index: 1;
    }

    .service-icon-circle {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: var(--bg-surface);
        border: 2px solid var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.4s var(--ease-out-expo);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    }

        .service-icon-circle:hover {
            transform: scale(1.05);
            border-color: var(--border-glow);
        }

    .service-icon-large {
        font-size: 4rem;
    }

    .service-icon-ring {
        position: absolute;
        inset: -60px;
        pointer-events: none;
    }

    .ring-icon {
        position: absolute;
        font-size: 1.8rem;
        animation: floatY 4s ease-in-out infinite;
    }

        .ring-icon:nth-child(1) {
            animation-delay: 0s;
        }

        .ring-icon:nth-child(2) {
            animation-delay: 0.5s;
        }

        .ring-icon:nth-child(3) {
            animation-delay: 1s;
        }

        .ring-icon:nth-child(4) {
            animation-delay: 1.5s;
        }

    .overview-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
        margin-top: var(--space-6);
    }

    .overview-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-5);
        text-align: center;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    }

        .overview-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
        }

    .overview-icon {
        font-size: 2.5rem;
        margin-bottom: var(--space-2);
    }

    .overview-card h4 {
        font-size: 1rem;
        margin: 0 0 var(--space-1);
    }

    .overview-card p {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin: 0;
    }

    .tech-section {
        background: rgba(0, 0, 0, 0.2);
        border-top: 1px solid var(--border-subtle);
        border-bottom: 1px solid var(--border-subtle);
    }

    .tech-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-4);
        margin-top: var(--space-6);
    }

    .tech-item {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        padding: var(--space-4);
        text-align: center;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
    }

        .tech-item:hover {
            transform: translateY(-4px);
            border-color: var(--accent-cyan);
        }

    .tech-icon-large {
        font-size: 2rem;
        display: block;
        margin-bottom: var(--space-1);
    }

    .tech-name {
        display: block;
        font-weight: 600;
        color: var(--text-primary);
    }

    .tech-desc {
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .pricing-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-5);
        margin-top: var(--space-6);
    }

    .pricing-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        text-align: center;
        transition: transform 0.3s var(--ease-out-expo), border-color 0.3s;
        position: relative;
    }

        .pricing-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-glow);
        }

        .pricing-card.featured {
            border-color: var(--accent-cyan);
            box-shadow: 0 0 40px rgba(0, 229, 255, 0.05);
        }

    .pricing-badge {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--accent-gradient);
        color: #04121a;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 16px;
        border-radius: 999px;
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .pricing-icon {
        font-size: 2.5rem;
    }

    .pricing-card h4 {
        font-size: 1.2rem;
        margin: var(--space-2) 0 var(--space-1);
    }

    .pricing-price {
        font-family: var(--font-display);
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--accent-cyan);
        margin-bottom: var(--space-4);
    }

    .pricing-features {
        list-style: none;
        padding: 0;
        margin: 0;
        text-align: left;
    }

        .pricing-features li {
            padding: var(--space-1) 0;
            color: var(--text-secondary);
            font-size: 0.9rem;
            border-bottom: 1px solid var(--border-subtle);
        }

            .pricing-features li:last-child {
                border-bottom: none;
            }

    @@media (max-width: 1024px) {
        .service-hero-grid {
            grid-template-columns: 1fr;
            min-height: auto;
            gap: var(--space-6);
        }

        .service-hero-content {
            order: 1;
        }

        .service-hero-visual {
            order: 0;
        }

        .service-headline {
            font-size: clamp(2rem, 4vw, 2.8rem);
        }

        .service-description {
            font-size: 1rem;
            max-width: 100%;
        }

        .overview-grid {
            grid-template-columns: 1fr 1fr;
        }

        .tech-grid {
            grid-template-columns: 1fr 1fr;
        }

        .pricing-grid {
            grid-template-columns: 1fr;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }
    }

    @@media (max-width: 600px) {
        .overview-grid {
            grid-template-columns: 1fr;
        }

        .tech-grid {
            grid-template-columns: 1fr;
        }

        .service-actions {
            flex-direction: column;
            width: 100%;
        }

            .service-actions .btn {
                width: 100%;
                justify-content: center;
            }

        .service-icon-circle {
            width: 120px;
            height: 120px;
        }

        .service-icon-large {
            font-size: 3rem;
        }

        .service-icon-ring {
            display: none;
        }

        .pricing-price {
            font-size: 1.4rem;
        }
    }
</style>