<style>
    .site-footer {
        padding: var(--space-8) 0 var(--space-4);
        border-top: 1px solid var(--border-subtle);
        background: var(--bg-void);
        position: relative;
        overflow: hidden;
    }

        .site-footer::before {
            content: "";
            position: absolute;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 600px;
            height: 200px;
            background: radial-gradient(ellipse at center, rgba(0, 229, 255, 0.04), transparent 70%);
            pointer-events: none;
        }

    .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1.2fr;
        gap: var(--space-6);
        padding-bottom: var(--space-6);
        border-bottom: 1px solid var(--border-subtle);
        position: relative;
        z-index: 1;
    }

    /* ===== BRAND ===== */
    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .footer-logo-wrapper {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }

    .footer-logo-img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        filter: drop-shadow(0 0 12px rgba(0, 229, 255, 0.2));
        transition: transform 0.4s var(--ease-out-expo);
    }

        .footer-logo-img:hover {
            transform: rotate(-6deg) scale(1.05);
        }

    .footer-brand-name {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: -0.02em;
    }

    .footer-tagline {
        color: var(--text-muted);
        font-size: 0.92rem;
        line-height: 1.6;
        max-width: 300px;
        margin: 0;
    }

    .footer-social {
        display: flex;
        gap: var(--space-2);
        margin-top: var(--space-2);
    }

    .social-link {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-muted);
        transition: all 0.3s var(--ease-out-expo);
        background: var(--bg-surface);
        cursor: pointer;
    }

        .social-link:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0, 229, 255, 0.12);
        }

    /* ===== LINKS ===== */
    .footer-links {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .footer-heading {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        margin-bottom: var(--space-1);
        font-weight: 600;
    }

    .footer-links a {
        color: var(--text-secondary);
        font-size: 0.9rem;
        transition: all 0.2s var(--ease-out-expo);
        text-decoration: none;
        position: relative;
        width: fit-content;
    }

        .footer-links a::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--accent-gradient);
            transition: width 0.3s var(--ease-out-expo);
        }

        .footer-links a:hover {
            color: var(--text-primary);
        }

            .footer-links a:hover::after {
                width: 100%;
            }

    /* ===== CONTACT ===== */
    .footer-contact {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .contact-link {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--text-secondary);
        font-size: 0.9rem;
        transition: all 0.2s var(--ease-out-expo);
        text-decoration: none;
    }

        .contact-link:hover {
            color: var(--accent-cyan);
            transform: translateX(4px);
        }

    .contact-icon {
        font-size: 1rem;
        opacity: 0.6;
    }

    .footer-availability {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-top: var(--space-2);
        padding: 6px 14px;
        background: rgba(0, 229, 255, 0.06);
        border: 1px solid rgba(0, 229, 255, 0.1);
        border-radius: 999px;
        font-size: 0.78rem;
        color: var(--text-secondary);
        width: fit-content;
    }

    .availability-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--success);
        animation: pulseGlow 2s ease-in-out infinite;
    }

    /* ===== BOTTOM ===== */
    .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: var(--space-4);
        flex-wrap: wrap;
        gap: var(--space-3);
        position: relative;
        z-index: 1;
    }

    .footer-bottom-content {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        flex-wrap: wrap;
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .footer-bottom-links {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

        .footer-bottom-links a {
            color: var(--text-muted);
            font-size: 0.78rem;
            transition: color 0.2s;
            text-decoration: none;
        }

            .footer-bottom-links a:hover {
                color: var(--accent-cyan);
            }

    .bottom-divider {
        color: var(--border-subtle);
        font-size: 0.8rem;
    }

    .back-to-top {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 8px 16px;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-sm);
        color: var(--text-secondary);
        font-size: 0.78rem;
        cursor: pointer;
        transition: all 0.3s var(--ease-out-expo);
        font-family: var(--font-body);
    }

        .back-to-top:hover {
            border-color: var(--accent-cyan);
            color: var(--accent-cyan);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(0, 229, 255, 0.08);
        }

        .back-to-top svg {
            transition: transform 0.3s var(--ease-out-expo);
        }

        .back-to-top:hover svg {
            transform: translateY(-2px);
        }

    /* ===== ANIMATIONS ===== */
    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(0, 229, 255, 0);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(0, 229, 255, 0.08);
        }
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .footer-grid {
            grid-template-columns: 1fr 1fr;
            gap: var(--space-5);
        }

        .footer-brand {
            grid-column: 1 / -1;
        }

        .footer-tagline {
            max-width: 100%;
        }
    }

    @@media (max-width: 600px) {
        .footer-grid {
            grid-template-columns: 1fr;
            gap: var(--space-4);
        }

        .footer-brand {
            grid-column: 1;
        }

        .footer-bottom {
            flex-direction: column-reverse;
            align-items: stretch;
            text-align: center;
        }

        .footer-bottom-content {
            flex-direction: column;
            gap: var(--space-2);
        }

        .footer-bottom-links {
            justify-content: center;
        }

        .back-to-top {
            justify-content: center;
            width: 100%;
        }

        .footer-availability {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 400px) {
        .footer-logo-wrapper {
            flex-direction: column;
            align-items: flex-start;
        }

        .footer-logo-img {
            width: 40px;
            height: 40px;
        }
    }
</style>

@code {
    private async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;
}