@using PersonalInformation.Services
@inject IJSRuntime JS
@inject ThemeService ThemeService
@implements IDisposable

<button class="nav-toggle" aria-label="Toggle menu">
    <span></span><span></span><span></span>
</button>

<aside class="site-nav">
    <a href="/" class="nav-logo" aria-label="CrossPlatformDev — Home">
        <img src="img/logo-icon.png" alt="CrossPlatformDev logo" class="logo-icon" />
    </a>

    <p class="nav-eyebrow">CrossPlatformDev - test</p>
    <nav class="nav-links">
        <NavLink href="/" Match="NavLinkMatch.All"><span class="nav-index">01</span> Home</NavLink>
        <NavLink href="/services"><span class="nav-index">02</span> Services</NavLink>
        <NavLink href="/portfolio"><span class="nav-index">03</span> Portfolio</NavLink>
        <NavLink href="/about"><span class="nav-index">04</span> About</NavLink>
        <NavLink href="/blog"><span class="nav-index">05</span> Blog</NavLink>
    </nav>

    <!-- Theme Toggle Button -->
    <div class="theme-toggle-wrapper">
        <button class="theme-toggle-btn" @onclick="ToggleTheme" aria-label="Toggle theme">
            <span class="theme-icon">@(ThemeService.IsDark ? "🌙" : "☀️")</span>
            <span class="theme-label">@(ThemeService.IsDark ? "Dark" : "Light")</span>
            <span class="theme-toggle-track">
                <span class="theme-toggle-thumb" style="transform: @(ThemeService.IsDark ? "translateX(20px)" : "translateX(0)")"></span>
            </span>
        </button>
    </div>

    <a href="/contact" class="btn btn-primary nav-cta">Start a Project</a>

    <span class="eyebrow nav-footer-tag">status: available</span>
</aside>

<div class="nav-overlay"></div>

@code {
    protected override void OnInitialized()
    {
        // Subscribe to theme changes
        ThemeService.OnThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        StateHasChanged(); // Force re-render when theme changes
    }

    private async Task ToggleTheme()
    {
        ThemeService.ToggleTheme();
        await JS.InvokeVoidAsync("localStorage.setItem", "theme", ThemeService.CurrentTheme);
        // StateHasChanged will be called by OnThemeChanged event
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }
}