<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050810" />
    <base href="/" />

    <title>CrossPlatformDev — Custom Websites, Mobile Apps &amp; Business Systems</title>
    <meta name="description" content="CrossPlatformDev builds custom websites, Android &amp; mobile apps, and business management systems (POS, inventory, supermarket systems) for growing businesses. 5+ years of full-stack development experience." />
    <meta name="keywords" content="website development, website creation, creating website, website for businesses, business website, mobile application, android application, system management, supermarket management system, custom software development" />
    <link rel="canonical" href="https://crossplatformdev.com/" />

    <meta property="og:site_name" content="CrossPlatformDev" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="CrossPlatformDev — Custom Websites, Mobile Apps &amp; Business Systems" />
    <meta property="og:description" content="Custom websites, mobile apps, and business management systems built for real businesses." />
    <meta property="og:url" content="https://crossplatformdev.com/" />
    <meta property="og:image" content="https://crossplatformdev.com/og-cover.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="shortcut icon" href="favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png" />
    <link rel="manifest" href="site.webmanifest" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <HeadOutlet @rendermode="InteractiveServer" />

    <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "WebSite",
              "name": "CrossPlatformDev",
              "url": "https://crossplatformdev.com",
              "description": "Custom website development, mobile apps, and business management systems.",
              "potentialAction": {
                "@@type": "SearchAction",
                "target": "https://crossplatformdev.com/search?q={search_term_string}",
                "query-input": "required name=search_term_string"
              }
            }
    </script>

    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["PersonalInformation.styles.css"]" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <script src="_framework/blazor.web.js"></script>
    <script src="js/site.js"></script>
    <script src="Components/Layout/ReconnectModal.razor.js"></script>
    <script src="js/home.js"></script>

    <!-- Suppress Blazor WebSocket messages -->
    <script>
        (function() {
        // Wait for Blazor to load
        const originalConsoleLog = console.log;
        const originalConsoleInfo = console.info;

        function shouldSuppress(message) {
        if (typeof message !== 'string') return false;
        return message.includes('blazor') ||
        message.includes('WebSocket') ||
        message.includes('_blazor') ||
        message.includes('Normalizing') ||
        message.includes('Information:');
        }

        console.log = function(...args) {
        if (args.length > 0 && shouldSuppress(args[0])) {
        return;
        }
        originalConsoleLog.apply(console, args);
        };

        console.info = function(...args) {
        if (args.length > 0 && shouldSuppress(args[0])) {
        return;
        }
        originalConsoleInfo.apply(console, args);
        };
        })();
    </script>
</body>
</html>