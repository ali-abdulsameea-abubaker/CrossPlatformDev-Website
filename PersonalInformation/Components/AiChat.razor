@using System.Text.Json
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using System.ComponentModel.DataAnnotations
@inject IConfiguration Config
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<div class="ai-chat-container @(isOpen ? "chat-open" : "")">
    <div class="ai-chat-header" @onclick="ToggleChat">
        <div class="ai-chat-header-left">
            <span class="ai-avatar">🤖</span>
            <div>
                <span class="ai-name">Ali's AI Assistant</span>
                <span class="ai-status">● Online</span>
            </div>
        </div>
        <div class="ai-chat-header-right">
            <span class="ai-toggle-icon">@(isOpen ? "✕" : "💬")</span>
        </div>
    </div>

    @if (isOpen)
    {
        <div class="ai-chat-body">

            @if (messages.Count == 0 && !showBookingForm)
            {
                <div class="ai-quick-topics">
                    <p class="ai-quick-topics-title">What are you looking for?</p>
                    <select class="ai-topic-select" @onchange="OnTopicSelected">
                        <option value="">Choose a topic — get an instant answer</option>
                        <option value="services">🌐 What services does Ali offer?</option>
                        <option value="pricing">💰 How much does a project cost?</option>
                        <option value="timeline">⏱️ How long does a project take?</option>
                        <option value="experience">🎯 What's Ali's experience?</option>
                        <option value="portfolio">📁 Can I see past work?</option>
                        <option value="contact">📧 How do I get in touch?</option>
                    </select>
                    <p class="ai-quick-topics-or">or just type your own question below</p>
                </div>
            }

            <div class="ai-chat-messages" id="chatMessages">
                @foreach (var message in messages)
                {
                    <div class="chat-message @(message.IsUser ? "user-message" : "ai-message")">
                        @if (!message.IsUser)
                        {
                            <span class="message-avatar">🤖</span>
                        }
                        <div class="message-content">
                            <div class="message-bubble">
                                @if (message.IsTyping)
                                {
                                    <span class="typing-indicator">
                                        <span></span><span></span><span></span>
                                    </span>
                                }
                                else
                                {
                                    @((MarkupString)FormatMessage(message.Text))
                                }
                            </div>
                            <span class="message-time">@message.Time</span>
                        </div>
                        @if (message.IsUser)
                        {
                            <span class="message-avatar">👤</span>
                        }
                    </div>
                }

                @if (showBookingForm)
                {
                    <div class="booking-card">
                        @if (bookingSubmitted)
                        {
                            <div class="booking-confirmed">
                                <div class="booking-confirmed-icon">✅</div>
                                <h4>Request sent!</h4>
                                <p>Ali will get back to you within <strong>2 working days</strong> to confirm your appointment.</p>
                            </div>
                        }
                        else
                        {
                            <h4 class="booking-title">📅 Schedule a call</h4>
                            <p class="booking-subtitle">Fill in your preferred time — Ali will confirm within 2 working days.</p>

                            <EditForm Model="@booking" OnValidSubmit="HandleBookingSubmit" OnInvalidSubmit="HandleBookingInvalid">
                                <DataAnnotationsValidator />

                                <div class="booking-row">
                                    <div class="booking-field">
                                        <label>Preferred Date</label>
                                        <InputDate @bind-Value="booking.Date" class="booking-input" min="@MinDate" />
                                    </div>
                                    <div class="booking-field">
                                        <label>Preferred Time</label>
                                        <InputText type="time" @bind-Value="booking.Time" class="booking-input" />
                                    </div>
                                </div>

                                <label>Email</label>
                                <InputText @bind-Value="booking.Email" class="booking-input" placeholder="you@email.com" />

                                <div class="booking-row">
                                    <div class="booking-field booking-field-small">
                                        <label>Country Code</label>
                                        <InputSelect @bind-Value="booking.CountryCode" class="booking-input">
                                            @foreach (var c in Countries)
                                            {
                                                <option value="@c.Code">@c.Flag @c.Code</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="booking-field">
                                        <label>Phone Number</label>
                                        <InputText @bind-Value="booking.Phone" class="booking-input" placeholder="289 339 1367" />
                                    </div>
                                </div>

                                <label>Country</label>
                                <InputSelect @bind-Value="booking.Country" class="booking-input">
                                    <option value="" disabled selected>Select your country</option>
                                    @foreach (var c in Countries)
                                    {
                                        <option value="@c.Name">@c.Flag @c.Name</option>
                                    }
                                </InputSelect>

                                <label>What's this about? (brief description)</label>
                                <InputTextArea @bind-Value="booking.Description" class="booking-input" rows="2" placeholder="e.g. Supermarket management system project" />

                                @if (bookingError is not null)
                                {
                                    <p class="booking-error">@bookingError</p>
                                }

                                <div class="booking-actions">
                                    <button type="button" class="booking-cancel-btn" @onclick="CancelBooking">Cancel</button>
                                    <button type="submit" class="booking-submit-btn" disabled="@bookingSending">
                                        @(bookingSending ? "Sending..." : "Request Appointment")
                                    </button>
                                </div>
                            </EditForm>
                        }
                    </div>
                }

                <div id="chatBottomAnchor"></div>
            </div>

            <div class="ai-chat-input">
                @if (messages.Count > 0 && !showBookingForm)
                {
                    <div class="quick-questions">
                        <button class="quick-btn" @onclick='() => SendQuickQuestion("What services do you offer?")'>💡 Services</button>
                        <button class="quick-btn" @onclick='() => SendQuickQuestion("How much do you charge?")'>💰 Pricing</button>
                        <button class="quick-btn quick-btn-highlight" @onclick="OpenBookingForm">📅 Schedule a Call</button>
                    </div>
                }
                @if (!showBookingForm)
                {
                    <div class="input-row">
                        <input type="text" @bind="userInput" @bind:event="oninput"
                               placeholder="Ask me anything..."
                               class="ai-input"
                               @onkeydown="OnKeyDown" />
                        <button class="ai-send-btn" @onclick="SendMessage" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="send-spinner"></span>
                            }
                            else
                            {
                                <span>➤</span>
                            }
                        </button>
                    </div>
                    <span class="ai-footer-note">💡 Powered by AI — ask about services, pricing, or anything else.</span>
                }
            </div>
        </div>
    }
</div>

<style>
    .ai-chat-container {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 1000;
        width: 380px;
        max-width: calc(100vw - 48px);
        font-family: var(--font-body, 'Inter', sans-serif);
    }

    .ai-chat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 18px;
        background: var(--accent-gradient, linear-gradient(135deg, #00E5FF 0%, #3D7FFF 100%));
        border-radius: 16px 16px 0 0;
        cursor: pointer;
        transition: transform 0.2s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
        user-select: none;
        box-shadow: 0 4px 24px rgba(0, 229, 255, 0.25);
    }

        .ai-chat-header:hover {
            transform: scale(1.01);
        }

    .ai-chat-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ai-avatar {
        font-size: 1.6rem;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        padding: 4px;
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ai-name {
        font-weight: 600;
        color: #04121a;
        font-size: 0.95rem;
    }

    .ai-status {
        font-size: 0.65rem;
        color: rgba(4, 18, 26, 0.7);
        display: block;
        margin-top: -2px;
        font-weight: 500;
    }

        .ai-status::before {
            content: "●";
            color: #3DDC97;
            margin-right: 4px;
            animation: pulseGlow 2s ease-in-out infinite;
        }

    .ai-chat-header-right {
        font-size: 1.2rem;
        color: #04121a;
        opacity: 0.7;
        transition: transform 0.3s;
    }

        .ai-chat-header-right:hover {
            transform: rotate(90deg);
        }

    .ai-chat-body {
        background: var(--bg-surface, #0B0F1A);
        border: 1px solid var(--border-subtle, #1C2436);
        border-top: none;
        border-radius: 0 0 16px 16px;
        overflow: hidden;
        box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
        animation: slideUp 0.3s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
        display: flex;
        flex-direction: column;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ===== QUICK TOPICS ===== */
    .ai-quick-topics {
        padding: 18px 16px;
        border-bottom: 1px solid var(--border-subtle, #1C2436);
        background: var(--bg-elevated, #121A2B);
    }

    .ai-quick-topics-title {
        margin: 0 0 10px;
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-primary, #EAF0F7);
    }

    .ai-topic-select {
        width: 100%;
        padding: 11px 14px;
        border-radius: 10px;
        border: 1px solid var(--border-subtle, #1C2436);
        background: var(--bg-void, #050810);
        color: var(--text-primary, #EAF0F7);
        font-size: 0.88rem;
        cursor: pointer;
        outline: none;
    }

        .ai-topic-select:focus {
            border-color: var(--accent-cyan, #00E5FF);
        }

        .ai-topic-select option {
            background: var(--bg-elevated, #121A2B);
        }

    .ai-quick-topics-or {
        margin: 8px 0 0;
        font-size: 0.7rem;
        color: var(--text-muted, #5E6B82);
        text-align: center;
    }

    .ai-chat-messages {
        max-height: 400px;
        overflow-y: auto;
        padding: 16px 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        scroll-behavior: smooth;
    }

        .ai-chat-messages::-webkit-scrollbar {
            width: 4px;
        }

        .ai-chat-messages::-webkit-scrollbar-track {
            background: transparent;
        }

        .ai-chat-messages::-webkit-scrollbar-thumb {
            background: var(--border-subtle, #1C2436);
            border-radius: 999px;
        }

    .chat-message {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        animation: fadeInMessage 0.3s var(--ease-out-expo);
    }

    @@keyframes fadeInMessage {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .chat-message.user-message {
        flex-direction: row-reverse;
    }

    .message-avatar {
        font-size: 1.2rem;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: var(--bg-elevated, #121A2B);
    }

    .message-content {
        display: flex;
        flex-direction: column;
        max-width: 80%;
    }

    .user-message .message-content {
        align-items: flex-end;
    }

    .message-bubble {
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--text-primary, #EAF0F7);
        word-wrap: break-word;
    }

    .ai-message .message-bubble {
        background: var(--bg-elevated, #121A2B);
        border: 1px solid var(--border-subtle, #1C2436);
        border-bottom-left-radius: 4px;
    }

    .user-message .message-bubble {
        background: var(--accent-gradient, linear-gradient(135deg, #00E5FF 0%, #3D7FFF 100%));
        color: #04121a;
        border-bottom-right-radius: 4px;
    }

    .message-time {
        font-size: 0.6rem;
        color: var(--text-muted, #5E6B82);
        margin-top: 4px;
        padding: 0 4px;
    }

    .typing-indicator {
        display: inline-flex;
        gap: 4px;
        padding: 4px 0;
    }

        .typing-indicator span {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--text-muted, #5E6B82);
            animation: typingBounce 1.4s ease-in-out infinite;
        }

            .typing-indicator span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .typing-indicator span:nth-child(3) {
                animation-delay: 0.4s;
            }

    @@keyframes typingBounce {
        0%, 60%, 100% {
            transform: translateY(0);
            opacity: 0.4;
        }

        30% {
            transform: translateY(-8px);
            opacity: 1;
        }
    }

    /* ===== BOOKING FORM ===== */
    .booking-card {
        background: var(--bg-elevated, #121A2B);
        border: 1px solid var(--border-glow, rgba(0,229,255,0.35));
        border-radius: 14px;
        padding: 16px;
        margin-top: 4px;
        animation: fadeInMessage 0.3s var(--ease-out-expo);
    }

    .booking-title {
        margin: 0 0 4px;
        font-size: 1rem;
        color: var(--text-primary, #EAF0F7);
        font-family: var(--font-display, inherit);
    }

    .booking-subtitle {
        margin: 0 0 14px;
        font-size: 0.78rem;
        color: var(--text-muted, #5E6B82);
        line-height: 1.5;
    }

    .booking-row {
        display: flex;
        gap: 8px;
    }

    .booking-field {
        flex: 1;
    }

    .booking-field-small {
        flex: 0 0 90px;
    }

    .booking-card label {
        display: block;
        font-size: 0.72rem;
        color: var(--text-muted, #5E6B82);
        margin: 10px 0 4px;
    }

    .booking-input {
        width: 100%;
        padding: 9px 11px;
        border-radius: 8px;
        border: 1px solid var(--border-subtle, #1C2436);
        background: var(--bg-void, #050810);
        color: var(--text-primary, #EAF0F7);
        font-family: inherit;
        font-size: 0.85rem;
        box-sizing: border-box;
    }

        .booking-input:focus {
            outline: none;
            border-color: var(--accent-cyan, #00E5FF);
        }

    .booking-error {
        color: var(--warning, #FFB020);
        font-size: 0.75rem;
        margin: 8px 0 0;
    }

    .booking-actions {
        display: flex;
        gap: 8px;
        margin-top: 14px;
    }

    .booking-cancel-btn {
        flex: 0 0 auto;
        padding: 9px 14px;
        border-radius: 8px;
        border: 1px solid var(--border-subtle, #1C2436);
        background: transparent;
        color: var(--text-secondary, #A7B2C4);
        font-size: 0.8rem;
        cursor: pointer;
    }

        .booking-cancel-btn:hover {
            border-color: var(--text-muted);
        }

    .booking-submit-btn {
        flex: 1;
        padding: 9px 14px;
        border-radius: 8px;
        border: none;
        background: var(--accent-gradient, linear-gradient(135deg, #00E5FF 0%, #3D7FFF 100%));
        color: #04121a;
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
    }

        .booking-submit-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .booking-confirmed {
        text-align: center;
        padding: 8px 0;
    }

    .booking-confirmed-icon {
        font-size: 2rem;
        margin-bottom: 6px;
    }

    .booking-confirmed h4 {
        margin: 0 0 6px;
        color: var(--text-primary, #EAF0F7);
        font-size: 1rem;
    }

    .booking-confirmed p {
        margin: 0;
        font-size: 0.82rem;
        color: var(--text-secondary, #A7B2C4);
        line-height: 1.5;
    }

    .booking-confirmed strong {
        color: var(--accent-cyan, #00E5FF);
    }

    .quick-btn-highlight {
        border-color: var(--accent-cyan, #00E5FF) !important;
        color: var(--accent-cyan, #00E5FF) !important;
    }

    .ai-chat-input {
        padding: 12px 14px 14px;
        border-top: 1px solid var(--border-subtle, #1C2436);
        background: var(--bg-elevated, #121A2B);
    }

    .quick-questions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .quick-btn {
        font-size: 0.65rem;
        padding: 4px 12px;
        border-radius: 999px;
        border: 1px solid var(--border-subtle, #1C2436);
        background: transparent;
        color: var(--text-secondary, #A7B2C4);
        cursor: pointer;
        transition: all 0.2s var(--ease-out-expo);
        white-space: nowrap;
    }

        .quick-btn:hover {
            border-color: var(--accent-cyan, #00E5FF);
            color: var(--accent-cyan, #00E5FF);
            transform: translateY(-1px);
        }

    .input-row {
        display: flex;
        gap: 8px;
    }

    .ai-input {
        flex: 1;
        padding: 10px 14px;
        border-radius: 10px;
        border: 1px solid var(--border-subtle, #1C2436);
        background: var(--bg-void, #050810);
        color: var(--text-primary, #EAF0F7);
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.3s;
    }

        .ai-input:focus {
            border-color: var(--accent-cyan, #00E5FF);
        }

        .ai-input::placeholder {
            color: var(--text-muted, #5E6B82);
        }

    .ai-send-btn {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        border: none;
        background: var(--accent-gradient, linear-gradient(135deg, #00E5FF 0%, #3D7FFF 100%));
        color: #04121a;
        font-size: 1.2rem;
        cursor: pointer;
        transition: transform 0.2s var(--ease-out-expo), opacity 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .ai-send-btn:hover:not(:disabled) {
            transform: scale(1.05);
        }

        .ai-send-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .send-spinner {
        width: 20px;
        height: 20px;
        border: 2px solid rgba(4, 18, 26, 0.2);
        border-top-color: #04121a;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .ai-footer-note {
        display: block;
        text-align: center;
        font-size: 0.55rem;
        color: var(--text-muted, #5E6B82);
        margin-top: 8px;
        letter-spacing: 0.02em;
    }

    @@media (max-width: 480px) {
        .ai-chat-container {
            bottom: 16px;
            right: 16px;
            width: 56px;
            transition: width 0.3s var(--ease-out-expo, cubic-bezier(0.16, 1, 0.3, 1));
        }

            .ai-chat-container.chat-open {
                width: calc(100vw - 32px);
            }

        .ai-chat-header {
            width: 56px;
            height: 56px;
            padding: 0;
            border-radius: 50%;
            justify-content: center;
            box-shadow: 0 4px 20px rgba(0, 229, 255, 0.35);
            transition: width 0.3s var(--ease-out-expo), border-radius 0.3s var(--ease-out-expo);
        }

        .ai-chat-container.chat-open .ai-chat-header {
            width: 100%;
            height: auto;
            padding: 14px 18px;
            border-radius: 16px 16px 0 0;
            justify-content: space-between;
        }

        .ai-chat-header-left {
            display: none;
        }

        .ai-chat-container.chat-open .ai-chat-header-left {
            display: flex;
        }

        .ai-chat-header-right {
            font-size: 1.4rem;
        }

        .ai-chat-messages {
            max-height: 50vh;
        }

        .booking-row {
            flex-direction: column;
        }

        .booking-field-small {
            flex: 1;
        }
    }

    @@keyframes pulseGlow {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(0, 229, 255, 0.35);
        }

        50% {
            box-shadow: 0 0 0 8px rgba(0, 229, 255, 0);
        }
    }
</style>

@code {
    private bool isOpen = false;
    private string? userInput;
    private bool isLoading = false;
    private List<ChatMessage> messages = new();
    private readonly HashSet<ChatMessage> notifiedMessages = new();

    private bool showBookingForm = false;
    private bool bookingSubmitted = false;
    private bool bookingSending = false;
    private string? bookingError;
    private BookingRequest booking = new();
    private string MinDate => DateTime.Today.ToString("yyyy-MM-dd");

    private const string SystemPrompt = @"You are Ali's AI assistant on his business website, CrossPlatformDev.
Ali Abubaker is a full-stack developer based in Hamilton, ON, Canada with 5+ years of experience.
He builds custom websites, mobile apps (Android/iOS), and business management systems (POS, inventory, supermarket systems).
Current role: .NET Software Developer at Gerrie Electric (Sep 2024–present). Previously IT Help Desk Technician (300+ resolved cases).
Advanced Diploma in Software Development, Mohawk College. Microsoft Azure certified.
Tech stack: C#, .NET Core, ASP.NET, Node.js, React, TypeScript, SQL Server, MySQL, MongoDB, Azure.
Pricing guide: simple website $1,500-$2,500, mobile app $5,000-$10,000, business system $5,000-$15,000+.
Timelines: website 2-4 weeks, mobile app 1-3 months, business system 2-4 months.
Contact: aliabdulsameea69@gmail.com, +1 289 339 1367.
Be warm, concise, and helpful. Keep answers short (2-4 sentences) unless asked for detail.
If asked something unrelated to Ali or his work, answer briefly and naturally, then gently steer back.
If the visitor wants to schedule a call or meeting, tell them you'll bring up a quick booking form for them to fill in — do not ask for date/time/contact details yourself in the chat, the form will collect that.
Never claim to send a message or email to Ali yourself — only the booking form actually notifies him.";

    private static readonly string[] ScheduleKeywords = new[]
    {
        "schedule", "book a call", "meeting", "appointment", "available on",
        "set up a call", "talk to ali", "speak with ali", "call me"
    };

    private static readonly string[] LeadKeywords = new[]
    {
        "quote", "hire", "want to start", "get started", "move forward",
        "concern", "complaint", "issue with", "problem with", "unhappy",
        "urgent", "deadline", "budget is", "my budget",
        "build me", "can you build", "i need a", "i want to create"
    };

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsUser { get; set; }
        public string Time { get; set; } = "";
        public bool IsTyping { get; set; }
    }

