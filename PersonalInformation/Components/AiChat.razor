@code {
    private bool isOpen = false;
    private string? userInput;
    private bool isLoading = false;
    private List<ChatMessage> messages = new();
    private readonly HashSet<ChatMessage> notifiedMessages = new();

    private const string SystemPrompt = @"You are Ali's AI assistant on his business website, CrossPlatformDev.
Ali Abubaker is a full-stack developer based in Hamilton, ON, Canada with 5+ years of experience.
He builds custom websites, mobile apps (Android/iOS), and business management systems (POS, inventory, supermarket systems).
Current role: .NET Software Developer at Gerrie Electric (Sep 2024–present). Previously IT Help Desk Technician (300+ resolved cases).
Advanced Diploma in Software Development, Mohawk College. Microsoft Azure certified.
Tech stack: C#, .NET Core, ASP.NET, Node.js, React, TypeScript, SQL Server, MySQL, MongoDB, Azure.
Pricing guide: simple website $1,500-$2,500, mobile app $5,000-$10,000, business system $5,000-$15,000+.
Timelines: website 2-4 weeks, mobile app 1-3 months, business system 2-4 months.
Contact: aliabdulsameea69@gmail.com, +1 289 339 1367.
Be warm, concise, and helpful. Keep answers short (2-4 sentences) unless asked for detail.
If asked something unrelated to Ali or his work, answer briefly and naturally, then gently steer back.
Never claim to send a message, email, or note to Ali yourself — you cannot actually do that.
Instead, tell the visitor their request has been noted and Ali will follow up, or point them to the contact form.";

    // Signals that a message is a real request worth notifying Ali about,
    // not just casual browsing or general questions.
    private static readonly string[] LeadKeywords = new[]
    {
        "schedule", "book a call", "meeting", "appointment", "available on",
        "quote", "hire", "want to start", "get started", "move forward",
        "concern", "complaint", "issue with", "problem with", "unhappy",
        "urgent", "deadline", "budget is", "my budget",
        "build me", "can you build", "i need a", "i want to create",
        "call me", "phone me", "reach me at"
    };

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsUser { get; set; }
        public string Time { get; set; } = "";
        public bool IsTyping { get; set; }
    }

    private void ToggleChat()
    {
        isOpen = !isOpen;
    }

    private async Task OnTopicSelected(ChangeEventArgs e)
    {
        var topic = e.Value?.ToString();
        if (string.IsNullOrEmpty(topic)) return;

        var question = topic switch
        {
            "services" => "What services do you offer?",
            "pricing" => "How much does a project cost?",
            "timeline" => "How long does a project take?",
            "experience" => "What's your experience?",
            "portfolio" => "Can I see your past work?",
            "contact" => "How do I get in touch?",
            _ => null
        };

        if (question is not null)
        {
            userInput = question;
            await SendMessage();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(userInput))
        {
            await SendMessage();
        }
    }

    private async Task SendQuickQuestion(string question)
    {
        userInput = question;
        await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isLoading) return;

        var userMessage = userInput.Trim();
        userInput = "";

        var newUserMessage = new ChatMessage { Text = userMessage, IsUser = true, Time = DateTime.Now.ToString("h:mm tt") };
        messages.Add(newUserMessage);
        StateHasChanged();
        await ScrollToBottom();

        var typingMessage = new ChatMessage { Text = "", IsUser = false, Time = DateTime.Now.ToString("h:mm tt"), IsTyping = true };
        messages.Add(typingMessage);
        StateHasChanged();
        await ScrollToBottom();

        isLoading = true;

        try
        {
            var response = await GetAiResponse(userMessage);
            messages.Remove(typingMessage);
            messages.Add(new ChatMessage { Text = response, IsUser = false, Time = DateTime.Now.ToString("h:mm tt") });

            // Check if this message looks like a real lead/request worth emailing Ali about.
            if (LooksLikeLead(userMessage) && !notifiedMessages.Contains(newUserMessage))
            {
                notifiedMessages.Add(newUserMessage);
                _ = NotifyAliByEmail(userMessage);
            }
        }
        catch
        {
            messages.Remove(typingMessage);
            messages.Add(new ChatMessage
            {
                Text = "Sorry, I'm having trouble connecting right now. Please try again or email Ali directly at aliabdulsameea69@gmail.com.",
                IsUser = false,
                Time = DateTime.Now.ToString("h:mm tt")
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private static bool LooksLikeLead(string message)
    {
        var lower = message.ToLowerInvariant();
        return LeadKeywords.Any(k => lower.Contains(k));
    }

    private async Task NotifyAliByEmail(string triggeringMessage)
    {
        try
        {
            var apiKey = Config["Resend:ApiKey"];
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                Console.WriteLine("Resend API key missing — skipping AI chat lead notification.");
                return;
            }

            // Build a readable transcript of the whole conversation so far.
            var transcript = string.Join("\n\n", messages
                .Where(m => !m.IsTyping)
                .Select(m => $"{(m.IsUser ? "Visitor" : "AI Assistant")} ({m.Time}): {m.Text}"));

            var payload = new
            {
                from = "CrossPlatformDev AI Chat <onboarding@resend.dev>",
                to = new[] { "aliabdulsameea69@gmail.com" },
                subject = "New request from AI chat on your website",
                text = $"A visitor's message triggered a lead notification:\n\n" +
                       $"\"{triggeringMessage}\"\n\n" +
                       $"---- Full conversation ----\n\n{transcript}"
            };

            var client = HttpClientFactory.CreateClient("Resend");
            client.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", apiKey);

            var response = await client.PostAsJsonAsync("emails", payload);

            if (!response.IsSuccessStatusCode)
            {
                var errBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"AI chat lead email failed: {response.StatusCode} - {errBody}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"AI chat lead email error: {ex.Message}");
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("siteAnimations.scrollChatToBottom", "chatMessages");
        }
        catch { /* ignore if JS not ready yet */ }
    }

    private static string FormatMessage(string text)
    {
        return System.Net.WebUtility.HtmlEncode(text).Replace("\n", "<br />");
    }

    private async Task<string> GetAiResponse(string userMessage)
    {
        var apiKey = Config["Groq:ApiKey"];
        if (string.IsNullOrWhiteSpace(apiKey))
        {
            return "AI chat isn't configured yet — please email Ali directly at aliabdulsameea69@gmail.com.";
        }

        var client = HttpClientFactory.CreateClient("Groq");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", apiKey);

        var historyMessages = new List<object> { new { role = "system", content = SystemPrompt } };
        foreach (var m in messages.Where(m => !m.IsTyping).TakeLast(12))
        {
            historyMessages.Add(new { role = m.IsUser ? "user" : "assistant", content = m.Text });
        }
        historyMessages.Add(new { role = "user", content = userMessage });

        var payload = new
        {
            model = "llama-3.1-8b-instant",
            messages = historyMessages,
            temperature = 0.6,
            max_tokens = 300
        };

        var response = await client.PostAsJsonAsync("chat/completions", payload);

        if (!response.IsSuccessStatusCode)
        {
            var errBody = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Groq error: {response.StatusCode} - {errBody}");
            return "Sorry, I couldn't process that right now. You can reach Ali directly at aliabdulsameea69@gmail.com.";
        }

        var json = await response.Content.ReadFromJsonAsync<GroqResponse>();
        var reply = json?.choices?.FirstOrDefault()?.message?.content?.Trim();

        return string.IsNullOrWhiteSpace(reply)
            ? "I'm not sure how to answer that — try asking about services, pricing, or experience, or email Ali directly."
            : reply;
    }

    private class GroqResponse
    {
        public List<GroqChoice>? choices { get; set; }
    }
    private class GroqChoice
    {
        public GroqMessage? message { get; set; }
    }
    private class GroqMessage
    {
        public string? content { get; set; }
    }
}