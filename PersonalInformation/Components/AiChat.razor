    private async Task NotifyAliByEmail(string kind, string details, string? replyToEmail)
    {
        try
        {
            var apiKey = Config["Resend:ApiKey"];
            if (string.IsNullOrWhiteSpace(apiKey))
            {
                Console.WriteLine("Resend API key missing — skipping AI chat notification.");
                return;
            }

            var transcript = string.Join("\n\n", messages
                .Where(m => !m.IsTyping)
                .Select(m => $"{(m.IsUser ? "Visitor" : "AI Assistant")} ({m.Time}): {m.Text}"));

            var bodyText = $"Type: {kind}\n\n{details}\n\n---- Chat transcript ----\n\n{transcript}";

            object payload = replyToEmail is not null
                ? new
                {
                    from = "CrossPlatformDev AI Chat <onboarding@resend.dev>",
                    to = new[] { "aliabdulsameea69@gmail.com" },
                    reply_to = replyToEmail,
                    subject = $"New {kind.ToLower()} from AI chat on your website",
                    text = bodyText
                }
                : new
                {
                    from = "CrossPlatformDev AI Chat <onboarding@resend.dev>",
                    to = new[] { "aliabdulsameea69@gmail.com" },
                    subject = $"New {kind.ToLower()} from AI chat on your website",
                    text = bodyText
                };

            var client = HttpClientFactory.CreateClient("Resend");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", apiKey);

            var response = await client.PostAsJsonAsync("emails", payload);

            if (!response.IsSuccessStatusCode)
            {
                var errBody = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"AI chat email failed: {response.StatusCode} - {errBody}");
                throw new Exception("Email send failed");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"AI chat email error: {ex.Message}");
            throw;
        }
    }

