    private async Task<string> GetAiResponse(string userMessage)
    {
        var apiKey = Config["Groq:ApiKey"];
        if (string.IsNullOrWhiteSpace(apiKey))
        {
            return "AI chat isn't configured yet — please email Ali directly at aliabdulsameea69@gmail.com.";
        }

        var client = HttpClientFactory.CreateClient("Groq");
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", apiKey);

        var historyMessages = new List<object> { new { role = "system", content = SystemPrompt } };
        foreach (var m in messages.Where(m => !m.IsTyping).TakeLast(12))
        {
            historyMessages.Add(new { role = m.IsUser ? "user" : "assistant", content = m.Text });
        }
        historyMessages.Add(new { role = "user", content = userMessage });

        var payload = new
        {
            model = "llama-3.1-8b-instant",
            messages = historyMessages,
            temperature = 0.6,
            max_tokens = 300
        };

        var response = await client.PostAsJsonAsync("chat/completions", payload);

        if (!response.IsSuccessStatusCode)
        {
            var errBody = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Groq error: {response.StatusCode} - {errBody}");
            return "Sorry, I couldn't process that right now. You can reach Ali directly at aliabdulsameea69@gmail.com.";
        }

        var json = await response.Content.ReadFromJsonAsync<GroqResponse>();
        var reply = json?.choices?.FirstOrDefault()?.message?.content?.Trim();

        return string.IsNullOrWhiteSpace(reply)
            ? "I'm not sure how to answer that — try asking about services, pricing, or experience, or email Ali directly."
            : reply;
    }

    private class GroqResponse { public List<GroqChoice>? choices { get; set; } }
    private class GroqChoice { public GroqMessage? message { get; set; } }
    private class GroqMessage { public string? content { get; set; } }
}