    private async Task OnTopicSelected(ChangeEventArgs e)
    {
        var topic = e.Value?.ToString();
        if (string.IsNullOrEmpty(topic)) return;

        var question = topic switch
        {
            "services" => "What services do you offer?",
            "pricing" => "How much does a project cost?",
            "timeline" => "How long does a project take?",
            "experience" => "What's your experience?",
            "portfolio" => "Can I see your past work?",
            "contact" => "How do I get in touch?",
            _ => null
        };

        if (question is not null)
        {
            userInput = question;
            await SendMessage();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(userInput))
        {
            await SendMessage();
        }
    }

    private async Task SendQuickQuestion(string question)
    {
        userInput = question;
        await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isLoading) return;

        var userMessage = userInput.Trim();
        userInput = "";

        var newUserMessage = new ChatMessage { Text = userMessage, IsUser = true, Time = DateTime.Now.ToString("h:mm tt") };
        messages.Add(newUserMessage);
        StateHasChanged();
        await ScrollToBottom();

        var typingMessage = new ChatMessage { Text = "", IsUser = false, Time = DateTime.Now.ToString("h:mm tt"), IsTyping = true };
        messages.Add(typingMessage);
        StateHasChanged();
        await ScrollToBottom();

        isLoading = true;

        try
        {
            var response = await GetAiResponse(userMessage);
            messages.Remove(typingMessage);
            messages.Add(new ChatMessage { Text = response, IsUser = false, Time = DateTime.Now.ToString("h:mm tt") });

            if (LooksLikeSchedule(userMessage))
            {
                showBookingForm = true;
            }
            else if (LooksLikeLead(userMessage) && !notifiedMessages.Contains(newUserMessage))
            {
                notifiedMessages.Add(newUserMessage);
                _ = NotifyAliByEmail("General inquiry", userMessage, null);
            }
        }
        catch
        {
            messages.Remove(typingMessage);
            messages.Add(new ChatMessage
            {
                Text = "Sorry, I'm having trouble connecting right now. Please try again or email Ali directly at aliabdulsameea69@gmail.com.",
                IsUser = false,
                Time = DateTime.Now.ToString("h:mm tt")
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private static bool LooksLikeSchedule(string message)
    {
        var lower = message.ToLowerInvariant();
        return ScheduleKeywords.Any(k => lower.Contains(k));
    }

    private static bool LooksLikeLead(string message)
    {
        var lower = message.ToLowerInvariant();
        return LeadKeywords.Any(k => lower.Contains(k));
    }

    private async Task HandleBookingSubmit()
    {
        bookingSending = true;
        bookingError = null;

        try
        {
            var dateStr = booking.Date?.ToString("dddd, MMMM d, yyyy") ?? "Not specified";
            var summary = $"Requested date: {dateStr}\n" +
                          $"Requested time: {booking.Time}\n" +
                          $"Phone: {booking.CountryCode} {booking.Phone}\n" +
                          $"Country: {booking.Country}\n" +
                          $"Description: {booking.Description}";

            await NotifyAliByEmail("Appointment request", summary, booking.Email);

            bookingSubmitted = true;
        }
        catch
        {
            bookingError = "Something went wrong sending your request — please try again or email Ali directly.";
        }
        finally
        {
            bookingSending = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

